type BootstrapStatusResponse = record {
  last_error : opt text;
  phase : text;
  ready : bool;
};
type CanicMetadataResponse = record {
  package_description : text;
  canister_version : nat64;
  canic_version : text;
  package_version : text;
  package_name : text;
};
type CapabilityProof = variant { Structural };
type CapabilityRequestMetadata = record {
  request_id : blob;
  ttl_ns : nat64;
  issued_at_ns : nat64;
};
type CapabilityService = variant { Root };
//
// ComponentBinding
//
// Complete immutable identity and placement of one concrete Component.
//
type ComponentBinding = record {
  placement_subnet : principal;
  component : text;
  role : text;
  canister_id : principal;
  fleet_subnet_root : principal;
  authority : FleetRegistryAuthority;
  component_spec : text;
  spec_hash : blob;
};
//
// ComponentChildBinding
//
// Complete immutable identity of one child at any depth in one exact Component tree.
//
type ComponentChildBinding = record {
  component : ComponentBinding;
  parent_canister_id : principal;
  role : text;
  canister_id : principal;
};
// Named response for the canister's current cycle balance.
type CycleBalanceStatusResponse = record { cycles : nat };
type CycleTrackerEntry = record { cycles : nat; timestamp_secs : nat64 };
type CyclesFundingPreflightResponse = variant {
  CooldownActive : record { retry_after_secs : nat64 };
  ChildBudgetExhausted : record {
    max_per_child : nat;
    remaining_child_budget : nat;
  };
  ParentFundingUnavailable : record { approved_cycles : nat };
};
type CyclesRequest = record {
  metadata : opt RootRequestMetadata;
  cycles : nat;
};
type CyclesResponse = variant {
  Transferred : record { cycles_transferred : nat };
  PreflightRejected : CyclesFundingPreflightResponse;
};
//
// Error
//
// Public API error payload. Only registered runtime reasons may originate a
// value; Candid/Serde decoding may still preserve any raw `u16`.
//
type Error = record { code : nat16 };
// One independently decodable opaque chunk selected by an application descriptor.
type FixtureChunkDescriptor = record { length : nat32; digest : blob };
// Authenticated target pull, pinned to the exact granted revision and content.
type FixtureChunkRead = record { grant : FixtureGrant; index : nat32 };
// One bounded, sequential Store upload; exact earlier chunks may be replayed.
type FixtureChunkUpload = record {
  content_id : blob;
  bytes : blob;
  index : nat32;
};
// Release-independent fixture content; release authority binds its resulting digest.
type FixtureDescriptor = record {
  format_hash : blob;
  schema_version : nat16;
  chunks : vec FixtureChunkDescriptor;
  encoded_length : nat64;
  completion_summary : blob;
};
// Current target authority, including revoked revisions retained against stale replay.
type FixtureGrant = record {
  enabled : bool;
  binding : FixtureTargetBinding;
  revision : nat64;
};
// Compare-and-set read-grant intent; stale grant or revoke messages cannot replace it.
type FixtureGrantRequest = record {
  enabled : bool;
  binding : FixtureTargetBinding;
  expected_revision : nat64;
};
// Durable source-byte progress; completion is not an application data receipt.
type FixtureSourceStatus = record {
  received_bytes : nat64;
  content_id : blob;
  complete : bool;
  chunk_count : nat32;
  next_chunk : nat32;
};
// Closed Store outcomes for deterministic caller retry and conflict handling.
type FixtureStoreError = variant {
  NotReady;
  Authority;
  NotFound;
  Bounds;
  Capacity;
  Sequence;
  Content;
  Conflict;
};
// Root-derived installation authority independent of reusable content identity.
type FixtureTargetBinding = record {
  content_id : blob;
  release_build_id : text;
  target : ManagedCanisterBinding;
  installation : blob;
};
//
// FleetActivationIdentity
//
type FleetActivationIdentity = record {
  fleet : FleetBinding;
  operation_id : blob;
  release_build_id : text;
};
//
// FleetActivationPhase
//
type FleetActivationPhase = variant { Active; Prepared };
type FleetActivationRequest = record {
  credential : FleetCredentialGenerationRef;
  operation_id : blob;
  activation_evidence_hash : blob;
};
//
// FleetActivationStatusResponse
//
type FleetActivationStatusResponse = record {
  activated_at_ns : opt nat64;
  cascade_manifest : opt vec FleetCascadeManifestEntry;
  credential : opt FleetCredentialGenerationRef;
  cascade : opt FleetCascadeActivationEvidence;
  credential_manifest : opt FleetCredentialManifest;
  identity : FleetActivationIdentity;
  phase : FleetActivationPhase;
};
//
// FleetBinding
//
// Immutable binding between one installed Fleet and its source App.
//
type FleetBinding = record { app : text; fleet : FleetKey };
//
// FleetCascadeActivationEvidence
//
type FleetCascadeActivationEvidence = variant {
  Applied : record {
    state_snapshot_hash : blob;
    topology_snapshot_hash : blob;
  };
  Source : record { cascade_manifest_hash : blob };
};
//
// FleetCascadeManifestEntry
//
type FleetCascadeManifestEntry = record {
  "principal" : principal;
  state_snapshot_hash : blob;
  topology_snapshot_hash : blob;
};
//
// FleetCoordinatorBinding
//
// Immutable Coordinator identity, placement and direct Fleet recovery authority.
//
type FleetCoordinatorBinding = record {
  fleet : FleetBinding;
  coordinator_subnet : principal;
  coordinator : principal;
  recovery_controllers : vec principal;
};
//
// FleetCredentialGenerationRef
//
type FleetCredentialGenerationRef = record {
  generation : nat64;
  manifest_hash : blob;
};
type FleetCredentialGenerationRequest = record {
  credential : FleetCredentialGenerationRef;
  operation_id : blob;
};
//
// FleetCredentialManifest
//
type FleetCredentialManifest = record {
  fleet : FleetKey;
  activation_id : blob;
  generation : nat64;
  root_policy_set_hash : blob;
  entries : vec FleetCredentialManifestEntry;
  renewal_template_set_hash : blob;
};
//
// FleetCredentialManifestEntry
//
type FleetCredentialManifestEntry = record {
  cert_hash : blob;
  root_issuer : principal;
  bundle_hash : blob;
  not_before_ns : nat64;
  proof_hash : blob;
  subject_canister : principal;
  expires_at_ns : nat64;
  key_identity_hash : blob;
};
//
// FleetKey
//
// Complete network-qualified Fleet identity.
//
type FleetKey = record { fleet_id : text; canonical_network_id : text };
//
// FleetMode
//
type FleetMode = variant { Enabled; Disabled; Readonly };
//
// FleetRegistryAuthority
//
// Exact Coordinator binding and reinstall-local authority epoch for one Fleet Registry.
//
type FleetRegistryAuthority = record {
  epoch : nat64;
  binding : FleetCoordinatorBinding;
};
type FleetStateInput = record {
  mode : FleetMode;
  cycles_funding_enabled : bool;
};
//
// FleetSubnetWasmStoreAuthority
//
// Exact reciprocal authority retained by one root and its host-installed sibling Store.
//
type FleetSubnetWasmStoreAuthority = record {
  placement_subnet : principal;
  wasm_store : principal;
  wasm_module_hash : blob;
  release_build_id : text;
  fleet_subnet_root : principal;
  authority : FleetRegistryAuthority;
  installation_controller : principal;
};
//
// FleetSubnetWasmStoreInitArgs
//
// Fresh-install operation identity plus one complete sibling Store authority.
//
type FleetSubnetWasmStoreInitArgs = record {
  install_id : blob;
  authority : FleetSubnetWasmStoreAuthority;
};
//
// ManagedCanisterBinding
//
// Immutable Registry-issued identity retained by one managed application Canister.
//
type ManagedCanisterBinding = variant {
  ComponentChild : ComponentChildBinding;
  Component : ComponentBinding;
};
type NonrootCyclesCapabilityEnvelopeV1 = record {
  "service" : CapabilityService;
  metadata : CapabilityRequestMetadata;
  capability_version : nat16;
  proof : CapabilityProof;
  capability : CyclesRequest;
};
type NonrootCyclesCapabilityResponseV1 = record { response : CyclesResponse };
type ObservabilityRequest = variant {
  CycleHistory : PageRequest;
  CycleBalance;
};
type ObservabilityResponse = variant {
  CycleHistory : Page;
  CycleBalance : CycleBalanceStatusResponse;
};
// Durable identity returned when one role-owned asynchronous command is accepted.
type OperationReceipt = record { operation_id : blob };
type Page = record { total : nat64; entries : vec CycleTrackerEntry };
type PageRequest = record { offset : nat64; limit : nat64 };
type Page_1 = record { total : nat64; entries : vec PublicHistoryPoint };
type Page_2 = record { total : nat64; entries : vec PublicMetric };
// Comparable cumulative-counter movement across adjacent slots in the same window.
type PublicCounterDelta = record { elapsed_ns : nat64; amount : nat };
// Local identity and responsiveness without diagnostic checks or Fleet readiness.
type PublicHealth = record {
  role : opt text;
  observed_at_ns : nat64;
  canister_id : principal;
  health : PublicHealthStatus;
};
// Public query responsiveness; no runtime diagnostics or Fleet readiness assessment.
type PublicHealthStatus = variant { responding };
// One actual observation, never an interpolated or replayed sample.
type PublicHistoryPoint = record {
  value : nat;
  kind : PublicMetricKind;
  observed_at_ns : nat64;
  slot_start_ns : nat64;
  delta : opt PublicCounterDelta;
};
// Select one exact cached series; points are ordered by five-minute slot.
type PublicHistoryRequest = record {
  name : text;
  page : PageRequest;
  canister_id : opt principal;
  family : PublicMetricFamily;
};
// Heap-only chart coverage. Missing slots are gaps, including across suspension.
type PublicHistorySnapshot = record {
  retention_ns : nat64;
  byte_limit : nat64;
  heap_started_at_ns : opt nat64;
  canister_version : nat64;
  series_limit : nat64;
  cadence_ns : nat64;
  truncated : bool;
  unit : opt text;
  state : PublicSnapshotState;
  stale_after_ns : nat64;
  coverage_start_ns : opt nat64;
  points : Page_1;
  reserved_bytes : nat64;
};
// An explicitly named aggregate value with an optional canister dimension.
type PublicMetric = record {
  value : nat;
  kind : PublicMetricKind;
  name : text;
  observed_at_ns : nat64;
  unit : text;
  canister_id : opt principal;
};
// Aggregate families an App may explicitly publish to every caller.
type PublicMetricFamily = variant {
  application;
  cycles;
  performance;
  operations;
  shard_occupancy;
};
// Interpretation of a sampled value. Counter windows must change on every reset.
type PublicMetricKind = variant {
  Gauge;
  Counter : record { window_id : nat64; saturated : bool };
  TimerCounter : record { registration : TimerMetricRegistration; saturated : bool };
};
type TimerMetricRegistration = record {
  canister_version : nat64;
  started_at_ns : nat64;
  sequence : nat64;
};
// Select a published aggregate family and one bounded page.
type PublicMetricsRequest = record {
  page : PageRequest;
  family : PublicMetricFamily;
};
// One cached aggregate snapshot. Reading it never refreshes it.
type PublicMetricsSnapshot = record {
  metrics : Page_2;
  sampled_at_ns : opt nat64;
  truncated : bool;
  state : PublicSnapshotState;
  stale_after_ns : nat64;
  family : PublicMetricFamily;
};
// Availability is data, independent of caller identity.
type PublicSnapshotState = variant { Stale; Disabled; Fresh; Unavailable };
type PublicStatusRequest = variant {
  Overview;
  History : PublicHistoryRequest;
  Health;
  Metrics : PublicMetricsRequest;
};
type PublicStatusResponse = variant {
  Overview : RoleOverviewResponse;
  History : PublicHistorySnapshot;
  Health : PublicHealth;
  Metrics : PublicMetricsSnapshot;
};
type Result = variant { Ok : ObservabilityResponse; Err : Error };
type Result_1 = variant { Ok : PublicStatusResponse; Err : Error };
type Result_10 = variant { Ok : Result_2; Err : Error };
type Result_11 = variant { Ok : StoreStatusResponse; Err : Error };
type Result_2 = variant { Ok : FixtureSourceStatus; Err : FixtureStoreError };
type Result_3 = variant { Ok : StoreCatalogReadResponse; Err : Error };
type Result_4 = variant { Ok : TemplateChunkResponse; Err : Error };
type Result_5 = variant { Ok : FixtureGrant; Err : FixtureStoreError };
type Result_6 = variant { Ok : StoreCommandResponse; Err : Error };
type Result_7 = variant { Ok : blob; Err : FixtureStoreError };
type Result_8 = variant { Ok : Result_7; Err : Error };
type Result_9 = variant { Ok; Err : Error };
// Closed compiled capability identity exposed by the immutable role overview.
type RoleCapability = variant {
  Sharding;
  Scaling;
  Root;
  FleetCoordinator;
  Index;
  Icrc21;
  ChildProvisioning;
  DelegatedTokenIssuer;
  FleetAdmissionProjection;
  RootDelegation;
  RoleAttestationSigner;
  WasmStore;
  DelegatedTokenVerifier;
  RoleAttestationVerifier;
  RootControlPlane;
  Runtime;
  AutomaticTopup;
};
// Immutable role, capability, release, and bootstrap profile-verification response.
type RoleOverviewResponse = record {
  capabilities : vec RoleCapability;
  metadata : CanicMetadataResponse;
  role : text;
  bootstrap : BootstrapStatusResponse;
  protocol_profile_digest : blob;
};
type RootRequestMetadata = record { request_id : blob; ttl_ns : nat64 };
type StateCascadeReport = record {
  successful_targets : nat64;
  reconciliation_failures : nat64;
  unconfirmed_targets : nat64;
  omitted_targets : nat64;
  targets : vec StateCascadeTargetOutcome;
};
type StateCascadeTargetOutcome = record {
  canister_id : principal;
  result : StateCascadeTargetResult;
};
type StateCascadeTargetResult = variant {
  Applied;
  AppliedWithReconciliationFailure : Error;
  Unconfirmed : Error;
};
type StateSnapshotInput = record { fleet_state : opt FleetStateInput };
type StoreCatalogReadRequest = variant {
  Storage;
  Template : TemplateLookupRequest;
  Catalog;
  Fixture : blob;
  FixtureGrant : principal;
};
type StoreCatalogReadResponse = variant {
  Storage : WasmStoreStatusResponse;
  Template : TemplateStagingStatusResponse;
  Catalog : vec WasmStoreCatalogEntryResponse;
  Fixture : Result_2;
  FixtureGrant : opt FixtureGrant;
};
// Closed Store control-plane command union.
type StoreCommand = variant {
  ActivateFleet : FleetActivationRequest;
  PrepareFixture : FixtureDescriptor;
  RespondCapability : NonrootCyclesCapabilityEnvelopeV1;
  PrepareChunkSet : TemplateChunkSetPrepareInput;
  SynchronizeState : StateSnapshotInput;
  SetFixtureGrant : FixtureGrantRequest;
  StageManifest : TemplateManifestInput;
  RunGc : WasmStoreGcRequest;
  InspectTemplate : TemplateLookupRequest;
  ReclaimDeletionCycles : WasmStoreDeletionCycleReclamationRequest;
  PrepareFleetCredential : FleetCredentialGenerationRequest;
  SynchronizeTopology : TopologySnapshotInput;
};
// Closed response union correlated to one accepted Store command.
type StoreCommandResponse = variant {
  FixtureSource : Result_2;
  RespondCapability : NonrootCyclesCapabilityResponseV1;
  PrepareChunkSet : TemplateChunkSetInfoResponse;
  SynchronizeState : StateCascadeReport;
  StageManifest;
  InspectTemplate : TemplateChunkSetInfoResponse;
  ReclaimDeletionCycles : WasmStoreDeletionCycleReclamationResponse;
  OperationAccepted : OperationReceipt;
  FixtureGrant : Result_5;
  SynchronizeTopology;
};
// Store-owned durable operation detail selected by one operation ID.
type StoreOperationStatusResponse = variant {
  FleetActivation : FleetActivationStatusResponse;
  GarbageCollection : WasmStoreGcOperationStatus;
};
type StoreStatusRequest = variant { Operation : OperationReceipt; Authority };
type StoreStatusResponse = variant {
  Operation : StoreOperationStatusResponse;
  Authority : FleetSubnetWasmStoreAuthority;
};
type TemplateChunkInput = record {
  preparation : opt TemplateChunkSetPrepareInput;
  chunk_index : nat32;
  template_id : text;
  version : text;
  bytes : blob;
};
// Exact template chunk key used by the Store's bounded read lane.
type TemplateChunkRequest = record {
  chunk_index : nat32;
  template_id : text;
  version : text;
};
type TemplateChunkResponse = record { bytes : blob };
type TemplateChunkSetInfoResponse = record { chunk_hashes : vec blob };
type TemplateChunkSetPrepareInput = record {
  manifest : opt TemplateManifestInput;
  payload_size_bytes : nat64;
  chunk_hashes : vec blob;
  template_id : text;
  version : text;
  payload_hash : blob;
};
//
// TemplateChunkingMode
//
type TemplateChunkingMode = variant { Chunked; Inline };
// Exact template release key used by Store command inspection.
type TemplateLookupRequest = record { template_id : text; version : text };
type TemplateManifestInput = record {
  role : text;
  payload_size_bytes : nat64;
  manifest_state : TemplateManifestState;
  approved_at : opt nat64;
  created_at : nat64;
  template_id : text;
  version : text;
  store_binding : text;
  chunking_mode : TemplateChunkingMode;
  payload_hash : blob;
};
type TemplateManifestResponse = record {
  role : text;
  payload_size_bytes : nat64;
  manifest_state : TemplateManifestState;
  approved_at : opt nat64;
  created_at : nat64;
  template_id : text;
  version : text;
  store_binding : text;
  chunking_mode : TemplateChunkingMode;
  payload_hash : blob;
};
//
// TemplateManifestState
//
type TemplateManifestState = variant { Blocked; Staged; Approved };
type TemplateStagingStatusResponse = record {
  expected_chunk_hashes : vec blob;
  expected_chunk_count : nat32;
  stored_chunk_hashes : vec opt blob;
  payload_size_bytes : opt nat64;
  stored_chunk_count : nat32;
  template_id : text;
  version : text;
  complete : bool;
  chunk_set_present : bool;
  manifest : opt TemplateManifestResponse;
  payload_hash : opt blob;
};
type TopologyChildren = record {
  children : vec TopologyDirectChild;
  parent_pid : principal;
};
type TopologyDirectChild = record { pid : principal; role : text };
type TopologyPathNode = record {
  pid : principal;
  role : text;
  parent_pid : opt principal;
};
type TopologySnapshotInput = record {
  children_map : vec TopologyChildren;
  parents : vec TopologyPathNode;
};
type WasmStoreCatalogEntryResponse = record {
  role : text;
  payload_size_bytes : nat64;
  template_id : text;
  version : text;
  payload_hash : blob;
};
type WasmStoreDeletionCycleReclamationRequest = record {
  retained_cycles_target : nat;
};
type WasmStoreDeletionCycleReclamationResponse = record {
  cycles_after : nat;
  retained_cycles_target : nat;
  destination : principal;
  cycles_transferred : nat;
  cycles_before : nat;
};
//
// WasmStoreGcMode
//
type WasmStoreGcMode = variant {
  Clearing;
  Complete;
  Normal;
  Prepared;
  InProgress;
};
// Store garbage-collection detail projected through the operation lane.
type WasmStoreGcOperationStatus = record {
  gc : WasmStoreGcStatusResponse;
  operation_id : blob;
};
// Root-owned retirement intent; preparation replay never authorizes collection.
type WasmStoreGcRequest = record {
  operation_id : blob;
  target : WasmStoreGcTarget;
};
type WasmStoreGcStatusResponse = record {
  prepared_at : opt nat64;
  changed_at : nat64;
  mode : WasmStoreGcMode;
  runs_completed : nat32;
  completed_at : opt nat64;
  started_at : opt nat64;
};
// Exact outcome requested from the existing Store retirement operation.
type WasmStoreGcTarget = variant { Complete; Prepared };
// Aggregate retained inventory; template and opaque fixture chunks stay distinct.
type WasmStoreInventoryResponse = record {
  expected_template_chunks : nat64;
  fixture_sources : nat64;
  stored_template_chunks : nat64;
  approved_catalog_entries : nat64;
  expected_fixture_chunks : nat64;
  stored_fixture_chunks : nat64;
};
type WasmStoreStatusResponse = record {
  gc : WasmStoreGcStatusResponse;
  templates : vec WasmStoreTemplateStatusResponse;
  occupied_store_bytes : nat64;
  headroom_bytes : opt nat64;
  remaining_store_bytes : nat64;
  inventory : WasmStoreInventoryResponse;
  max_store_bytes : nat64;
  max_template_versions_per_template : opt nat16;
  max_templates : opt nat32;
  within_headroom : bool;
  remaining_store_size : text;
  release_count : nat32;
  headroom_size : opt text;
  max_store_size : text;
  occupied_store_size : text;
  template_count : nat32;
};
type WasmStoreTemplateStatusResponse = record {
  template_id : text;
  versions : nat16;
};
service : (FleetSubnetWasmStoreInitArgs) -> {
  canic_observability : (ObservabilityRequest) -> (Result) query;
  canic_public_status : (PublicStatusRequest) -> (Result_1) query;
  canic_wasm_store_catalog : (StoreCatalogReadRequest) -> (Result_3) query;
  canic_wasm_store_chunk : (TemplateChunkRequest) -> (Result_4);
  canic_wasm_store_command : (StoreCommand) -> (Result_6);
  canic_wasm_store_fixture_chunk : (FixtureChunkRead) -> (Result_8);
  canic_wasm_store_publish_chunk : (TemplateChunkInput) -> (Result_9);
  canic_wasm_store_publish_fixture : (FixtureChunkUpload) -> (Result_10);
  canic_wasm_store_status : (StoreStatusRequest) -> (Result_11) query;
  icrc10_supported_standards : () -> (vec record { text; text }) query;
}
