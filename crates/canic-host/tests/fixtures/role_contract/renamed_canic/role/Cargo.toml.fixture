[package]
name = "fixture_renamed_canic_role"
version = { workspace = true }
edition = { workspace = true }
publish = false
build = "build.rs"

[package.metadata.canic]
app = "fixture_renamed_canic"
role = "app"

[package.metadata.cargo-machete]
ignored = ["framework"]

[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
framework = { workspace = true, features = [] }

[build-dependencies]
canic = { workspace = true, features = [] }
