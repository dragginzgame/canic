type BootstrapStatusResponse = record {
  last_error : opt text;
  phase : text;
  ready : bool;
};
type CanicMetadataResponse = record {
  package_description : text;
  canister_version : nat64;
  canic_version : text;
  package_version : text;
  package_name : text;
};
type CapabilityProof = variant { Structural };
type CapabilityRequestMetadata = record {
  request_id : blob;
  ttl_ns : nat64;
  issued_at_ns : nat64;
};
type CapabilityService = variant { Root };
// Named response for the canister's current cycle balance.
type CycleBalanceStatusResponse = record { cycles : nat };
type CycleTrackerEntry = record { cycles : nat; timestamp_secs : nat64 };
type CyclesFundingPreflightResponse = variant {
  CooldownActive : record { retry_after_secs : nat64 };
  ChildBudgetExhausted : record {
    max_per_child : nat;
    remaining_child_budget : nat;
  };
  ParentFundingUnavailable : record { approved_cycles : nat };
};
type CyclesRequest = record {
  metadata : opt RootRequestMetadata;
  cycles : nat;
};
type CyclesResponse = variant {
  Transferred : record { cycles_transferred : nat };
  PreflightRejected : CyclesFundingPreflightResponse;
};
//
// Error
//
// Public API error payload. Only registered runtime reasons may originate a
// value; Candid/Serde decoding may still preserve any raw `u16`.
//
type Error = record { code : nat16 };
//
// FleetActivationIdentity
//
type FleetActivationIdentity = record {
  fleet : FleetBinding;
  operation_id : blob;
  release_build_id : text;
};
//
// FleetActivationPhase
//
type FleetActivationPhase = variant { Active; Prepared };
type FleetActivationRequest = record {
  credential : FleetCredentialGenerationRef;
  operation_id : blob;
  activation_evidence_hash : blob;
};
//
// FleetActivationStatusResponse
//
type FleetActivationStatusResponse = record {
  activated_at_ns : opt nat64;
  cascade_manifest : opt vec FleetCascadeManifestEntry;
  credential : opt FleetCredentialGenerationRef;
  cascade : opt FleetCascadeActivationEvidence;
  credential_manifest : opt FleetCredentialManifest;
  identity : FleetActivationIdentity;
  phase : FleetActivationPhase;
};
//
// FleetBinding
//
// Immutable binding between one installed Fleet and its source App.
//
type FleetBinding = record { app : text; fleet : FleetKey };
//
// FleetCascadeActivationEvidence
//
type FleetCascadeActivationEvidence = variant {
  Applied : record {
    state_snapshot_hash : blob;
    topology_snapshot_hash : blob;
  };
  Source : record { cascade_manifest_hash : blob };
};
//
// FleetCascadeManifestEntry
//
type FleetCascadeManifestEntry = record {
  "principal" : principal;
  state_snapshot_hash : blob;
  topology_snapshot_hash : blob;
};
//
// FleetCoordinatorBinding
//
// Immutable identity and exact physical placement of one Fleet Coordinator.
//
type FleetCoordinatorBinding = record {
  fleet : FleetBinding;
  coordinator_subnet : principal;
  coordinator : principal;
};
//
// FleetCredentialGenerationRef
//
type FleetCredentialGenerationRef = record {
  generation : nat64;
  manifest_hash : blob;
};
type FleetCredentialGenerationRequest = record {
  credential : FleetCredentialGenerationRef;
  operation_id : blob;
};
//
// FleetCredentialManifest
//
type FleetCredentialManifest = record {
  fleet : FleetKey;
  activation_id : blob;
  generation : nat64;
  root_policy_set_hash : blob;
  entries : vec FleetCredentialManifestEntry;
  renewal_template_set_hash : blob;
};
//
// FleetCredentialManifestEntry
//
type FleetCredentialManifestEntry = record {
  cert_hash : blob;
  root_issuer : principal;
  bundle_hash : blob;
  not_before_ns : nat64;
  proof_hash : blob;
  subject_canister : principal;
  expires_at_ns : nat64;
  key_identity_hash : blob;
};
//
// FleetKey
//
// Complete network-qualified Fleet identity.
//
type FleetKey = record { fleet_id : text; canonical_network_id : text };
//
// FleetMode
//
type FleetMode = variant { Enabled; Disabled; Readonly };
//
// FleetRegistryAuthority
//
// Exact Coordinator binding and reinstall-local authority epoch for one Fleet Registry.
//
type FleetRegistryAuthority = record {
  epoch : nat64;
  binding : FleetCoordinatorBinding;
};
type FleetStateInput = record {
  mode : FleetMode;
  cycles_funding_enabled : bool;
};
//
// FleetSubnetWasmStoreAuthority
//
// Exact reciprocal authority retained by one root and its host-installed sibling Store.
//
type FleetSubnetWasmStoreAuthority = record {
  placement_subnet : principal;
  wasm_store : principal;
  wasm_module_hash : blob;
  release_build_id : text;
  fleet_subnet_root : principal;
  authority : FleetRegistryAuthority;
  installation_controller : principal;
};
//
// FleetSubnetWasmStoreInitArgs
//
// Fresh-install operation identity plus one complete sibling Store authority.
//
type FleetSubnetWasmStoreInitArgs = record {
  install_id : blob;
  authority : FleetSubnetWasmStoreAuthority;
};
type NonrootCyclesCapabilityEnvelopeV1 = record {
  "service" : CapabilityService;
  metadata : CapabilityRequestMetadata;
  capability_version : nat16;
  proof : CapabilityProof;
  capability : CyclesRequest;
};
type NonrootCyclesCapabilityResponseV1 = record { response : CyclesResponse };
// Durable identity returned when one role-owned asynchronous command is accepted.
type OperationReceipt = record { operation_id : blob };
// Lookup key shared by each role's local durable-operation status variant.
type OperationStatusRequest = record { operation_id : blob };
type Page = record { total : nat64; entries : vec CycleTrackerEntry };
type PageRequest = record { offset : nat64; limit : nat64 };
type Result = variant { Ok : StoreCommandResponse; Err : Error };
type Result_1 = variant { Ok : StoreStatusResponse; Err : Error };
type Result_2 = variant { Ok : TemplateChunkResponse; Err : Error };
type Result_3 = variant { Ok; Err : Error };
// Closed compiled capability identity exposed by the immutable role overview.
type RoleCapability = variant {
  Sharding;
  Scaling;
  Root;
  FleetCoordinator;
  Index;
  Icrc21;
  DelegatedTokenIssuer;
  FleetAdmissionProjection;
  RoleAttestationSigner;
  WasmStore;
  DelegatedTokenVerifier;
  RoleAttestationVerifier;
  RootControlPlane;
  Runtime;
  AutomaticTopup;
};
// Immutable role, capability, release, and bootstrap profile-verification response.
type RoleOverviewResponse = record {
  capabilities : vec RoleCapability;
  metadata : CanicMetadataResponse;
  role : text;
  bootstrap : BootstrapStatusResponse;
  protocol_profile_digest : blob;
};
type RootRequestMetadata = record { request_id : blob; ttl_ns : nat64 };
type StateSnapshotInput = record { fleet_state : opt FleetStateInput };
// Closed Store control-plane command union.
type StoreCommand = variant {
  ActivateFleet : FleetActivationRequest;
  RespondCapability : NonrootCyclesCapabilityEnvelopeV1;
  PrepareChunkSet : TemplateChunkSetPrepareInput;
  SynchronizeState : StateSnapshotInput;
  StageManifest : TemplateManifestInput;
  RunGc : OperationStatusRequest;
  InspectTemplate : TemplateLookupRequest;
  ReclaimDeletionCycles : WasmStoreDeletionCycleReclamationRequest;
  PrepareFleetCredential : FleetCredentialGenerationRequest;
  SynchronizeTopology : TopologySnapshotInput;
};
// Closed response union correlated to one accepted Store command.
type StoreCommandResponse = variant {
  RespondCapability : NonrootCyclesCapabilityResponseV1;
  PrepareChunkSet : TemplateChunkSetInfoResponse;
  SynchronizeState;
  StageManifest;
  InspectTemplate : TemplateChunkSetInfoResponse;
  ReclaimDeletionCycles : WasmStoreDeletionCycleReclamationResponse;
  OperationAccepted : OperationReceipt;
  SynchronizeTopology;
};
// Store-owned durable operation detail selected by one operation ID.
type StoreOperationStatusResponse = variant {
  FleetActivation : FleetActivationStatusResponse;
  GarbageCollection : WasmStoreGcOperationStatus;
};
// Closed Store observation selector carried by its single status query.
type StoreStatusRequest = variant {
  Storage;
  Overview;
  CycleHistory : PageRequest;
  Operation : OperationReceipt;
  Authority;
  Template : TemplateLookupRequest;
  Catalog;
  CycleBalance;
};
// Closed response union for the Store's single status query.
type StoreStatusResponse = variant {
  Storage : WasmStoreStatusResponse;
  Overview : RoleOverviewResponse;
  CycleHistory : Page;
  Operation : StoreOperationStatusResponse;
  Authority : FleetSubnetWasmStoreAuthority;
  Template : TemplateStagingStatusResponse;
  Catalog : vec WasmStoreCatalogEntryResponse;
  CycleBalance : CycleBalanceStatusResponse;
};
type TemplateChunkInput = record {
  chunk_index : nat32;
  template_id : text;
  version : text;
  bytes : blob;
};
// Exact template chunk key used by the Store's bounded read lane.
type TemplateChunkRequest = record {
  chunk_index : nat32;
  template_id : text;
  version : text;
};
type TemplateChunkResponse = record { bytes : blob };
type TemplateChunkSetInfoResponse = record { chunk_hashes : vec blob };
type TemplateChunkSetPrepareInput = record {
  payload_size_bytes : nat64;
  chunk_hashes : vec blob;
  template_id : text;
  version : text;
  payload_hash : blob;
};
//
// TemplateChunkingMode
//
type TemplateChunkingMode = variant { Chunked; Inline };
// Exact template release key used by Store command inspection.
type TemplateLookupRequest = record { template_id : text; version : text };
type TemplateManifestInput = record {
  role : text;
  payload_size_bytes : nat64;
  manifest_state : TemplateManifestState;
  approved_at : opt nat64;
  created_at : nat64;
  template_id : text;
  version : text;
  store_binding : text;
  chunking_mode : TemplateChunkingMode;
  payload_hash : blob;
};
//
// TemplateManifestState
//
type TemplateManifestState = variant { Blocked; Staged; Approved };
type TemplateStagingStatusResponse = record {
  expected_chunk_hashes : vec blob;
  expected_chunk_count : nat32;
  stored_chunk_hashes : vec opt blob;
  payload_size_bytes : opt nat64;
  stored_chunk_count : nat32;
  template_id : text;
  version : text;
  complete : bool;
  chunk_set_present : bool;
  manifest : opt TemplateManifestInput;
  payload_hash : opt blob;
};
type TopologyChildren = record {
  children : vec TopologyDirectChild;
  parent_pid : principal;
};
type TopologyDirectChild = record { pid : principal; role : text };
type TopologyPathNode = record {
  pid : principal;
  role : text;
  parent_pid : opt principal;
};
type TopologySnapshotInput = record {
  children_map : vec TopologyChildren;
  parents : vec TopologyPathNode;
};
type WasmStoreCatalogEntryResponse = record {
  role : text;
  payload_size_bytes : nat64;
  template_id : text;
  version : text;
  payload_hash : blob;
};
type WasmStoreDeletionCycleReclamationRequest = record {
  retained_cycles_target : nat;
};
type WasmStoreDeletionCycleReclamationResponse = record {
  cycles_after : nat;
  retained_cycles_target : nat;
  destination : principal;
  cycles_transferred : nat;
  cycles_before : nat;
};
//
// WasmStoreGcMode
//
type WasmStoreGcMode = variant {
  Clearing;
  Complete;
  Normal;
  Prepared;
  InProgress;
};
// Store garbage-collection detail projected through the operation lane.
type WasmStoreGcOperationStatus = record {
  gc : WasmStoreGcStatusResponse;
  operation_id : blob;
};
type WasmStoreGcStatusResponse = record {
  prepared_at : opt nat64;
  changed_at : nat64;
  mode : WasmStoreGcMode;
  runs_completed : nat32;
  completed_at : opt nat64;
  started_at : opt nat64;
};
type WasmStoreStatusResponse = record {
  gc : WasmStoreGcStatusResponse;
  templates : vec WasmStoreTemplateStatusResponse;
  occupied_store_bytes : nat64;
  headroom_bytes : opt nat64;
  remaining_store_bytes : nat64;
  max_store_bytes : nat64;
  max_template_versions_per_template : opt nat16;
  max_templates : opt nat32;
  within_headroom : bool;
  remaining_store_size : text;
  release_count : nat32;
  headroom_size : opt text;
  max_store_size : text;
  occupied_store_size : text;
  template_count : nat32;
};
type WasmStoreTemplateStatusResponse = record {
  template_id : text;
  versions : nat16;
};
service : (FleetSubnetWasmStoreInitArgs) -> {
  canic_command : (StoreCommand) -> (Result);
  canic_status : (StoreStatusRequest) -> (Result_1) query;
  canic_wasm_store_chunk : (TemplateChunkRequest) -> (Result_2);
  canic_wasm_store_publish_chunk : (TemplateChunkInput) -> (Result_3);
  icrc10_supported_standards : () -> (vec record { text; text }) query;
}
