+#[test]
+fn canic188_exact_quiescent_repair_preserves_authority_and_rejects_replay() {
+    let retained: PoolImportStatus =
+        candid::decode_one(include_bytes!("canic188-status.bin")).unwrap();
+    let mut record = PoolImportRecord {
+        reserved_at_ns: retained.reserved_at_ns,
+        reservation: retained.reservation.clone(),
+        progress: retained
+            .progress
+            .iter()
+            .enumerate()
+            .map(|(index, progress)| match progress {
+                PoolImportSourceProgress::Ready(receipt) => {
+                    PoolImportResetProgressRecord::Ready(receipt.clone())
+                }
+                PoolImportSourceProgress::Stopped => PoolImportResetProgressRecord::Stopped {
+                    retained_total_cycles: retained.reservation.sources[index].observed_cycles,
+                    canister_version: retained.reservation.sources[index].canister_version + 2,
+                },
+                PoolImportSourceProgress::AwaitingHandoff => {
+                    PoolImportResetProgressRecord::AwaitingHandoff
+                }
+                _ => panic!("the frozen record must have no issued destructive effect"),
+            })
+            .collect(),
+        phase: PoolImportPhaseRecord::Reserved,
+        paid_calls: retained.paid_calls,
+        reserved_debit_cycles: retained.reserved_debit_cycles,
+        last_root_cycles: retained.last_root_cycles,
+        root_receipt: None,
+    };
+    let root = record.reservation.root;
+    let before = record.clone();
+    let balance = retained.last_root_cycles - 50_000_000_000;
+    let mut wrong = before.clone();
+    wrong.paid_calls += 1;
+    assert_eq!(
+        reconcile_canic188_record(&mut wrong, root, balance)
+            .map_err(canic_core::dto::error::Error::from),
+        Err(InternalError::conflict().into())
+    );
+    assert_eq!(
+        reconcile_canic188_record(&mut record, Principal::anonymous(), balance)
+            .map_err(canic_core::dto::error::Error::from),
+        Err(InternalError::conflict().into())
+    );
+    assert_eq!(record, before);
+    reconcile_canic188_record(&mut record, root, balance).unwrap();
+    assert_eq!(record.reservation, before.reservation);
+    assert_eq!(record.progress, before.progress);
+    assert_eq!(record.paid_calls, 94);
+    assert_eq!(record.last_root_cycles, balance);
+    assert_eq!(
+        record.reserved_debit_cycles,
+        record.reservation.observed_root_cycles - balance
+    );
+    let repaired = record.clone();
+    assert_eq!(
+        reconcile_canic188_record(&mut record, root, balance)
+            .map_err(canic_core::dto::error::Error::from),
+        Err(InternalError::conflict().into())
+    );
+    assert_eq!(record, repaired);
+    let remaining = retained
+        .progress
+        .iter()
+        .zip(&retained.reservation.sources)
+        .map(|(progress, source)| match progress {
+            PoolImportSourceProgress::Ready(_) => 0,
+            PoolImportSourceProgress::Stopped => 12,
+            PoolImportSourceProgress::AwaitingHandoff if source.stopped => 12,
+            PoolImportSourceProgress::AwaitingHandoff => 17,
+            _ => panic!("issued effect blocks this repair"),
+        })
+        .sum::<u32>()
+        + 1;
+    assert_eq!(remaining, 242);
+    assert!(remaining + record.paid_calls <= record.reservation.maximum_paid_calls);
+}
