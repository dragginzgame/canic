+// This incident artifact admits only the exact quiescent record, once.
+fn reconcile_canic188_record(
+    record: &mut PoolImportRecord,
+    root: Principal,
+    retained: u128,
+) -> Result<(), InternalError> {
+    let bytes = candid::encode_one(status(record)).map_err(|_| InternalError::invariant())?;
+    let expected = [
+        0xe5, 0xe4, 0x06, 0x5b, 0xf8, 0xdd, 0xf9, 0xe6, 0x94, 0xb4, 0x7e, 0xde, 0x06, 0x1f, 0x9e,
+        0x07, 0x64, 0x13, 0x89, 0xae, 0x2a, 0xe6, 0x70, 0xdd, 0x0c, 0x24, 0xee, 0x18, 0x53, 0x00,
+        0xbe, 0x33,
+    ];
+    let digest: [u8; 32] = Sha256::digest(bytes).into();
+    if digest != expected || record.reservation.root != root {
+        return Err(InternalError::conflict());
+    }
+    let debit = record
+        .reservation
+        .observed_root_cycles
+        .checked_sub(retained)
+        .filter(|debit| *debit <= record.reservation.maximum_root_debit_cycles)
+        .ok_or_else(InternalError::resource_exhausted)?;
+    if retained > record.last_root_cycles || retained < record.reservation.minimum_root_cycles {
+        return Err(InternalError::conflict());
+    }
+    record.reserved_debit_cycles = debit;
+    record.last_root_cycles = retained;
+    Ok(())
+}
