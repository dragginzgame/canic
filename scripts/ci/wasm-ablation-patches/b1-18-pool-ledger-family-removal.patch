-        .as_table()
-        .ok_or("Cargo.lock package is not a table")?;
-    let field = |name: &str| {
-        table
-            .get(name)
-            .and_then(toml::Value::as_str)
-            .map(str::to_string)
-    };
-    Ok((
-        field("name").ok_or("Cargo.lock package omits name")?,
-        field("version").ok_or("Cargo.lock package omits version")?,
-        field("source"),
-        field("checksum"),
-    ))
-}
