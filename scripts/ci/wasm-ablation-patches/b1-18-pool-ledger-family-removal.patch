-fn lock_dependency_reference(identity: &LockPackageIdentity) -> String {
-    identity.2.as_ref().map_or_else(
-        || format!("{} {}", identity.0, identity.1),
-        |source| format!("{} {} ({source})", identity.0, identity.1),
-    )
-}
