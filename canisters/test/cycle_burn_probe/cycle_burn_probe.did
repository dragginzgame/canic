type BurnProbeError = variant {
  AccessDenied;
  AlreadyUsed;
  InsufficientBalance : record {
    available_cycles : nat;
    required_cycles : nat;
  };
};

type BurnReceipt = record {
  requested_cycles : nat;
  burned_cycles : nat;
  balance_before_cycles : nat;
  balance_after_burn_cycles : nat;
  caller : principal;
  executed_at_ns : nat64;
};

type BurnStatus = record {
  authorized_burn_cycles : nat;
  minimum_retained_cycles : nat;
  current_balance_cycles : nat;
  receipt : opt BurnReceipt;
};

service : {
  burn_once : () -> (variant { Ok : BurnReceipt; Err : BurnProbeError });
  burn_status : () -> (variant { Ok : BurnStatus; Err : BurnProbeError }) query;
};
