+#[test]
+fn hundred_thousand_sessions_restore_authorize_retry_and_logout() {
+    let _lock = seams::lock();
+    let _state = ApplicationSessionTestStateGuard::empty();
+    let selected = crate::model::auth::application_authorization::capacity::DEFAULT_MAX_SESSIONS;
+    assert_eq!(selected, 100_000);
+    LocalApplicationAuthorizationStateOps::configure_receiver_capacity(selected).unwrap();
+    LocalApplicationAuthorizationStateOps::restore_application_session_state(NOW).unwrap();
+    let mut owner = store();
+    for device in 1..=selected {
+        let (session, replay, login) = fixture::pair_for_browser(false, device);
+        assert_eq!(owner.admit(session, replay, &login), Ok(false));
+    }
+    let original = LocalApplicationAuthorizationState::export();
+    let (session, replay, login) = fixture::pair_for_browser(false, selected + 1);
+    assert_eq!(
+        owner.admit(session, replay, &login),
+        Err(SessionError::Capacity)
+    );
+    assert_eq!(LocalApplicationAuthorizationState::export(), original);
+    invalidate_indexes();
+    let stats =
+        LocalApplicationAuthorizationStateOps::restore_application_session_state(NOW).unwrap();
+    assert_eq!(
+        (stats.sessions, stats.replays),
+        (selected as usize, selected as usize)
+    );
+    assert!(stats.stable_bytes < capacity().stable_bytes);
+    assert!(stats.estimated_index_bytes < capacity().index_bytes);
+    let mut ledger = restore_ledger();
+    let mut budget = SessionAdmissionBudget::new(4, 1, 0).unwrap();
+    for device in [1, selected] {
+        let authorized = fixture::authorize(
+            &mut owner,
+            &mut ledger,
+            NOW,
+            0,
+            &["read".into()],
+            |authority| {
+                authority.caller = browser(device).into();
+            },
+        )
+        .unwrap();
+        let issued = fixture::issue(false, device, Principal::from_slice(&[43]), 42);
+        assert_eq!(
+            fixture::establish_issued(
+                &mut owner,
+                &mut ledger,
+                &mut budget,
+                &issued,
+                browser(device),
+                NOW
+            ),
+            Ok(ic_auth::session::SessionEstablished::ExactRetry(
+                ic_auth::session::SessionReceipt::from(&authorized)
+            ))
+        );
+    }
+    assert!(matches!(
+        ic_auth::session::logout_session(
+            &mut owner,
+            &mut ledger,
+            &mut budget,
+            browser(1).into(),
+            NOW
+        ),
+        LogoutResult::Revoked { .. }
+    ));
+    invalidate_indexes();
+    LocalApplicationAuthorizationStateOps::restore_application_session_state(NOW).unwrap();
+    let mut ledger = restore_ledger();
+    assert_eq!(
+        fixture::authorize(&mut owner, &mut ledger, NOW, 0, &["read".into()], |_| {}),
+        Err(SessionError::Revocation(
+            ic_auth::portable::LoginRevocationError::Revoked
+        ))
+    );
+    let (session, replay, login) = fixture::pair_for_browser(false, selected + 1);
+    assert_eq!(owner.admit(session, replay, &login), Ok(false));
+    owner
+        .read(|reader| {
+            assert_eq!(
+                reader.occupancy(browser(selected + 1).into())?.sessions,
+                selected as usize
+            );
+            Ok(())
+        })
+        .unwrap();
+}
