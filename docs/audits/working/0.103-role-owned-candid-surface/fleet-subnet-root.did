  LedgerTransferFailed;
  NotifyFailed;
  Refunded;
  NotifyMaxAttempts;
  CyclesSentOverflow;
  Duplicate;
  InvalidLedgerBlockIndex;
  InvalidTransaction;
  BadFee;
  TransferWindowStale;
  Processing;
  TransactionTooOld;
};
