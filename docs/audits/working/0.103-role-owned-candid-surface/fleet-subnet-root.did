};
// 
// RootComponentChildAllocationRequest
// 
// Parent command naming one idempotent direct-child reservation intent.
// 
type RootComponentChildAllocationRequest = record {
  child_role : text;
  component : text;
  application_init_args : opt blob;
  operation_id : blob;
  expected_registry : ComponentRegistryHead;
};
// 
// RootComponentChildAllocationResponse
// 
// Durable direct-child lifecycle progress returned identically for exact parent retry.
// 
type RootComponentChildAllocationResponse = record {
  maximum_descendants : nat32;
  child_kind : ComponentChildKind;
  child_role : text;
  component : text;
  maximum_registry_bytes : nat64;
  parent_canister_id : principal;
  creation : opt RootComponentCreationEvidence;
  operation_id : blob;
  maximum_instances_per_parent : nat32;
  reserved_against_registry : ComponentRegistryHead;
  phase : RootComponentAllocationPhase;
  installation : opt RootComponentChildInstallEvidence;
  release_set : FleetSubnetRootReleaseSet;
  parent_role : text;
};
// 
// RootComponentChildCommitResponse
// 
// Exact committed child operation, authoritative Component Registry and next Directory head.
// 
type RootComponentChildCommitResponse = record {
  directory : ComponentDirectoryHead;
  allocation : RootComponentChildAllocationResponse;
  registry : ComponentRegistryPartitionResponse;
};
// 
// RootComponentChildDirectoryPreparationResponse
// 
// Exact child preparation plus stable bounded active-member Directory coverage.
// 
type RootComponentChildDirectoryPreparationResponse = record {
  child : ComponentRuntimeStatusResponse;
  owning_component : ComponentRuntimeDirectoryConvergenceEvidence;
  committed : RootComponentChildCommitResponse;
  parent : opt ComponentRuntimeDirectoryConvergenceEvidence;
};
// 
// RootComponentChildInstallEvidence
// 
// Exact child module and immutable retained binding frozen before installation.
// 
type RootComponentChildInstallEvidence = record {
  chunk_hashes : vec blob;
  binding : ComponentChildBinding;
  raw_module_hash : blob;
};
// 
// RootComponentChildMembershipActivationResponse
// 
// Original child commitment plus active Registry, Directory and target convergence evidence.
// 
type RootComponentChildMembershipActivationResponse = record {
  directory : ComponentDirectoryHead;
  child : ComponentRuntimeStatusResponse;
  committed : RootComponentChildCommitResponse;
  registry : ComponentRegistryPartitionResponse;
};
// 
// RootComponentChildRuntimeActivationResponse
// 
// Exact child commitment plus independently observed Directory-bound runtime activation.
// 
type RootComponentChildRuntimeActivationResponse = record {
  child : ComponentRuntimeStatusResponse;
  committed : RootComponentChildCommitResponse;
};
// 
// RootComponentCommitResponse
// 
// Exact committed allocation, authoritative Registry row and derived Directory head.
// 
type RootComponentCommitResponse = record {
  directory : ComponentDirectoryHead;
  allocation : RootComponentAllocationResponse;
  registry : ComponentRegistryPartitionResponse;
};
// 
// RootComponentCreationEvidence
// 
// Exact Store artifact and root-owned creation settings frozen before the paid effect.
// 
type RootComponentCreationEvidence = record {
  controller : principal;
  initial_cycles : nat;
  wasm_store : principal;
  payload_size_bytes : nat64;
  canister : opt principal;
  payload_hash : blob;
};
// 
// RootComponentDeletedReceipt
// 
// Terminal authority retained after the top-level workload Canister is recycled.
// 
type RootComponentDeletedReceipt = record {
  deletion : RootComponentDeletionIntent;
  deleted_at_ns : nat64;
};
// 
// RootComponentDeletionIntent
// 
// Complete final-inventory and quiescence authority frozen before top-level deletion.
// 
type RootComponentDeletionIntent = record {
  final_inventory : RootComponentFinalInventory;
  prepared_at_ns : nat64;
  quiescence : RootComponentQuiescentReceipt;
};
// 
// RootComponentDeletionPhase
// 
// Monotonic top-level deletion progress through terminal local-membership removal.
// 
type RootComponentDeletionPhase = variant {
  MembershipRemoved : RootComponentMembershipRemovedReceipt;
  DeleteIntent : RootComponentDeletionIntent;
  Deleted : RootComponentDeletedReceipt;
};
// 
// RootComponentDeletionRequest
// 
// Controller command reconciling one top-level deletion from frozen final inventory.
// 
type RootComponentDeletionRequest = record {
  component : text;
  operation_id : blob;
  expected_inventory_hash : blob;
};
// 
// RootComponentDeletionResponse
// 
// Current durable deletion progress for one finalized top-level Component.
// 
type RootComponentDeletionResponse = record {
  component : text;
  operation_id : blob;
  phase : RootComponentDeletionPhase;
};
// 
// RootComponentDirectoryPreparationResponse
// 
// Exact root authority plus independently observed target-local Directory preparation.
// 
type RootComponentDirectoryPreparationResponse = record {
  committed : RootComponentCommitResponse;
  target : ComponentRuntimeStatusResponse;
};
// 
// RootComponentDirectorySynchronizationRequest
// 
// Coordinator-authenticated command advancing one affected-root scale-out Directory step.
// 
type RootComponentDirectorySynchronizationRequest = record {
  plan_hash : blob;
  expected_synchronized_component_count : nat32;
  operation_id : blob;
  published_fleet_registry : FleetRegistryVersion;
  source_fleet_registry : FleetRegistryVersion;
};
// 
// RootComponentDirectorySynchronizationResponse
// 
// Compact exact progress for one root's affected existing service members.
// 
type RootComponentDirectorySynchronizationResponse = record {
  plan_hash : blob;
  affected_component_count : nat32;
  synchronized_component_count : nat32;
  operation_id : blob;
  fleet_directory_content_hash : blob;
  complete : bool;
  published_fleet_registry : FleetRegistryVersion;
  receipt_content_hash : blob;
  fleet_subnet_root : principal;
  source_fleet_registry : FleetRegistryVersion;
  synchronized_at_ns : opt nat64;
};
// 
// RootComponentDrainingAdvancePhase
// 
// One bounded driver result: current subtree progress or exact empty inventory.
// 
type RootComponentDrainingAdvancePhase = variant {
  DescendantRemoval : RootComponentSubtreeRemovalResponse;
  DescendantsEmpty : RootComponentDrainingDescendantsEmpty;
};
// 
// RootComponentDrainingAdvanceResponse
// 
// Current bounded progress of one terminally quiescent Component drain.
// 
type RootComponentDrainingAdvanceResponse = record {
  component : text;
  operation_id : blob;
  phase : RootComponentDrainingAdvancePhase;
};
// 
// RootComponentDrainingDescendantsEmpty
// 
// Exact current Registry proof that one draining Component has no descendants.
// 
type RootComponentDrainingDescendantsEmpty = record {
  registry : ComponentRegistryHead;
  descendant_content_hash : blob;
};
// 
// RootComponentDrainingRequest
// 
// Controller command fencing one exact active Component against new mutation.
// 
type RootComponentDrainingRequest = record {
  component : text;
  operation_id : blob;
  expected_registry : ComponentRegistryHead;
};
// 
// RootComponentDrainingResponse
// 
// Exact Registry and Directory authority produced by the durable draining fence.
// 
type RootComponentDrainingResponse = record {
  component : text;
  descendant_count : nat32;
  started_at_ns : nat64;
  directory_authority_hash : blob;
  operation_id : blob;
  registry : ComponentRegistryHead;
  descendant_content_hash : blob;
  previous_registry : ComponentRegistryHead;
};
// 
// RootComponentFinalInventory
// 
// Exact empty Component Registry and current Fleet Directory authority frozen before deletion.
// 
type RootComponentFinalInventory = record {
  directory_synchronized_at_ns : nat64;
  registry_encoded_bytes : nat64;
  directory_authority_hash : blob;
  covered_fleet_registry_revision : nat64;
  covered_fleet_registry_content_hash : blob;
  finalized_at_ns : nat64;
  registry : ComponentRegistryHead;
  inventory_hash : blob;
  descendant_content_hash : blob;
};
// 
// RootComponentFinalInventoryResponse
// 
// Response-idempotent receipt for one finalized empty Component inventory.
// 
type RootComponentFinalInventoryResponse = record {
  component : text;
  inventory : RootComponentFinalInventory;
  operation_id : blob;
};
// 
// RootComponentInitialInventoryStatus
// 
// Durable initial Component inventory sealed for one Fleet Subnet Root activation.
// 
type RootComponentInitialInventoryStatus = record {
  sealed_at_ns : nat64;
  fleet_activation_operation_id : blob;
  directories_converged : bool;
  inventory_hash : blob;
  component_count : nat32;
  root_runtime_activated : bool;
};
// 
// RootComponentInstallEvidence
// 
// Exact raw artifact, chunk source and immutable target binding frozen before installation.
// 
type RootComponentInstallEvidence = record {
  chunk_hashes : vec blob;
  binding : ComponentBinding;
  raw_module_hash : blob;
};
// 
// RootComponentMembershipActivationResponse
// 
// Exact active Registry authority plus independently observed current target Directory.
// 
type RootComponentMembershipActivationResponse = record {
  directory : ComponentDirectoryHead;
  target : ComponentRuntimeStatusResponse;
  allocation : RootComponentAllocationResponse;
  registry : ComponentRegistryPartitionResponse;
};
// 
// RootComponentMembershipRemovedReceipt
// 
// Terminal local-membership removal and settled root/Spec accounting authority.
// 
type RootComponentMembershipRemovedReceipt = record {
  root_known_created_component_canisters : nat32;
  deleted : RootComponentDeletedReceipt;
  allocation_operation_id : blob;
  root_committed_component_instances : nat32;
  removed_at_ns : nat64;
  root_registry_encoded_bytes : nat64;
  removal_hash : blob;
  remaining_spec_committed_instances : nat32;
};
// Coordinator-authenticated command asking one root to retain its exact plan batch.
type RootComponentProvisioningAcceptanceRequest = record {
  fleet_registry : FleetRegistryVersion;
  plan_hash : blob;
  operation_id : blob;
  batch : FleetSubnetRootProvisioningBatch;
  configuration_digest : blob;
};
// Coordinator-authenticated command advancing one exact bounded provisioning step.
type RootComponentProvisioningAdvanceRequest = record {
  plan_hash : blob;
  expected_registry_committed_component_count : nat32;
  expected_claimed_component_count : nat32;
  expected_reserved_component_count : nat32;
  expected_installed_component_count : nat32;
  operation_id : blob;
};
// Durable aggregate progress of one root provisioning batch.
type RootComponentProvisioningPhase = variant {
  RuntimesActive;
  Provisioned;
  Accepted;
  Published;
};
// Complete group-partitioned result of one root provisioning operation.
type RootComponentProvisioningResult = record {
  placements : vec RootProvisionedGroupPlacement;
};
// Read-only lookup key for one exact root provisioning operation.
type RootComponentProvisioningStatusRequest = record {
  plan_hash : blob;
  operation_id : blob;
};
// Durable progress or complete terminal result for one exact root provisioning operation.
type RootComponentProvisioningStatusResponse = record {
  fleet_registry : FleetRegistryVersion;
  result : opt RootComponentProvisioningResult;
  activation_started_at_ns : opt nat64;
  plan_hash : blob;
  published_component_count : nat32;
  provisioned_at_ns : opt nat64;
  activated_component_count : nat32;
  operation_id : blob;
  runtimes_activated_at_ns : opt nat64;
  published_at_ns : opt nat64;
  root_runtime_active : bool;
  claimed_component_count : nat32;
  installed_component_count : nat32;
  receipt_content_hash : blob;
  accepted_at_ns : nat64;
  fleet_subnet_root : principal;
  reserved_component_count : nat32;
  activation : opt RootComponentActivationEvidence;
  phase : RootComponentProvisioningPhase;
  registry_committed_component_count : nat32;
  placement_count : nat32;
  configuration_digest : blob;
  component_count : nat32;
  publication : opt RootComponentPublicationEvidence;
};
// Complete root-local evidence for one published provisioning batch.
type RootComponentPublicationEvidence = record {
  fleet_registry : FleetRegistryVersion;
  fleet_directory_content_hash : blob;
  component_group_directories : vec ComponentGroupDirectoryPublicationEvidence;
  component_directories : vec ComponentDirectoryPublicationEvidence;
};
// Coordinator-authenticated command advancing one bounded root publication step.
type RootComponentPublicationRequest = record {
  plan_hash : blob;
  operation_id : blob;
  published_fleet_registry : FleetRegistryVersion;
  expected_published_component_count : nat32;
};
// 
// RootComponentQuiescencePhase
// 
// Monotonic progress from pre-effect stop authority to observed quiescence.
// 
type RootComponentQuiescencePhase = variant {
  StopIntent : RootComponentQuiescenceStopIntent;
  Quiescent : RootComponentQuiescentReceipt;
};
// 
// RootComponentQuiescenceResponse
// 
// Current durable quiescence progress for one draining Component.
// 
type RootComponentQuiescenceResponse = record {
  component : text;
  operation_id : blob;
  phase : RootComponentQuiescencePhase;
};
// 
// RootComponentQuiescenceStopIntent
// 
// Exact runtime, Directory, module and controller authority frozen before stopping.
// 
type RootComponentQuiescenceStopIntent = record {
  controller : principal;
  descendant_count : nat32;
  expected_module_hash : blob;
  prepared_at_ns : nat64;
  canister_id : principal;
  runtime_operation_id : blob;
  covered_fleet_registry_revision : nat64;
  activation : ComponentRuntimeActivationEvidence;
  covered_fleet_registry_content_hash : blob;
  registry : ComponentRegistryHead;
  covered_authority_hash : blob;
  descendant_content_hash : blob;
};
// 
// RootComponentQuiescentReceipt
// 
// Durable evidence that the exact prepared Component was independently observed stopped.
// 
type RootComponentQuiescentReceipt = record {
  stop : RootComponentQuiescenceStopIntent;
  quiesced_at_ns : nat64;
  observed_module_hash : blob;
};
// 
// RootComponentRegistryPreparationRequest
// 
// Exact authority required before an empty root-local Component Registry may be prepared.
// 
type RootComponentRegistryPreparationRequest = record {
  store_bootstrap : RootStoreBootstrapRequest;
  expected_fleet_registry : FleetRegistryVersion;
};
// 
// RootComponentRegistryStatusResponse
// 
// Compact durable Component Registry authority and current allocation counters.
// 
type RootComponentRegistryStatusResponse = record {
  next_allocation_sequence : nat64;
  component_topology_digest : blob;
  initial_inventory : opt RootComponentInitialInventoryStatus;
  known_created_component_canisters : nat32;
  committed_component_instances : nat32;
  prepared_against_registry : FleetRegistryVersion;
  managed_descendants : nat32;
  reserved_component_instances : nat32;
  fleet_subnet_root : principal;
  encoded_bytes : nat64;
  release_set : FleetSubnetRootReleaseSet;
};
// 
// RootComponentRuntimeActivationResponse
// 
// Exact root authority plus independently observed target-local runtime activation.
// 
type RootComponentRuntimeActivationResponse = record {
  committed : RootComponentCommitResponse;
  target : ComponentRuntimeStatusResponse;
};
// 
// RootComponentSubtreeRemovalAdvanceRequest
// 
// Controller command advancing bounded traversal from one observed durable step.
// 
type RootComponentSubtreeRemovalAdvanceRequest = record {
  component : text;
  operation_id : blob;
  expected_traversal_steps : nat32;
};
// 
// RootComponentSubtreeRemovalCompletedReceipt
// 
// Terminal Registry and Directory authority after the fenced target is finalized.
// 
type RootComponentSubtreeRemovalCompletedReceipt = record {
  directory_authority_hash : blob;
  registry : ComponentRegistryHead;
};
// 
// RootComponentSubtreeRemovalDeleteIntent
// 
// Exact stopped receipt frozen before the destructive management call.
// 
type RootComponentSubtreeRemovalDeleteIntent = record {
  stopped : RootComponentSubtreeRemovalStoppedReceipt;
};
// 
// RootComponentSubtreeRemovalDeleteRequest
// 
// Controller command reconciling and deleting one exactly prepared leaf.
// 
type RootComponentSubtreeRemovalDeleteRequest = record {
  component : text;
  operation_id : blob;
  expected_leaf_parent_canister_id : principal;
  expected_traversal_steps : nat32;
  expected_leaf_canister_id : principal;
};
// 
// RootComponentSubtreeRemovalDeletedReceipt
// 
// Frozen workload-deletion authority committed after the Canister is recycled.
// 
type RootComponentSubtreeRemovalDeletedReceipt = record {
  deletion : RootComponentSubtreeRemovalDeleteIntent;
};
// 
// RootComponentSubtreeRemovalDirectoryConvergenceEvidence
// 
// Compact durable proof that one surviving member covered the required Directory.
// 
type RootComponentSubtreeRemovalDirectoryConvergenceEvidence = record {
  canister_id : principal;
  operation_id : blob;
  activation : ComponentRuntimeActivationEvidence;
};
// 
// RootComponentSubtreeRemovalDirectorySynchronizedReceipt
// 
// Membership removal plus independently verified surviving-member convergence.
// 
// The owner is absent only when its top-level Component is durably quiescent.
// 
type RootComponentSubtreeRemovalDirectorySynchronizedReceipt = record {
  covered_component_registry : ComponentRegistryHead;
  owning_component : opt RootComponentSubtreeRemovalDirectoryConvergenceEvidence;
  membership_removed : RootComponentSubtreeRemovalMembershipRemovedReceipt;
  covered_fleet_registry_revision : nat64;
  covered_fleet_registry_content_hash : blob;
  covered_authority_hash : blob;
  parent : opt RootComponentSubtreeRemovalDirectoryConvergenceEvidence;
};
// 
// RootComponentSubtreeRemovalMembershipRemovedReceipt
// 
// Exact Registry transition retained after the independently deleted leaf is unregistered.
// 
type RootComponentSubtreeRemovalMembershipRemovedReceipt = record {
  root_known_created_component_canisters : nat32;
  directory_synchronized_at_ns : nat64;
  parent_role_instances : nat32;
  deleted : RootComponentSubtreeRemovalDeletedReceipt;
  registry_encoded_bytes : nat64;
  directory_authority_hash : blob;
  previous_committed_descendants : nat32;
  reserved_descendants : nat32;
  previous_descendant_content_hash : blob;
  committed_descendants : nat32;
  registry : ComponentRegistryHead;
  descendant_content_hash : blob;
  removed_from_registry : ComponentRegistryHead;
  root_managed_descendants : nat32;
};
// 
// RootComponentSubtreeRemovalNode
// 
// Exact registered child selected as a traversal cursor or removable leaf.
// 
type RootComponentSubtreeRemovalNode = record {
  status : ComponentLifecycleStatus;
  parent_canister_id : principal;
  kind : ComponentChildKind;
  role : text;
  canister_id : principal;
  installed_artifact_hash : blob;
};
// 
// RootComponentSubtreeRemovalPhase
// 
// Durable root-local progress of one child-subtree removal operation.
// 
type RootComponentSubtreeRemovalPhase = variant {
  DirectorySynchronized : RootComponentSubtreeRemovalDirectorySynchronizedReceipt;
  MembershipRemoved : RootComponentSubtreeRemovalMembershipRemovedReceipt;
  Stopped : RootComponentSubtreeRemovalStoppedReceipt;
  Traversing : RootComponentSubtreeRemovalNode;
  Fenced;
  StopIntent : RootComponentSubtreeRemovalStopIntent;
  DeleteIntent : RootComponentSubtreeRemovalDeleteIntent;
  LeafSelected : RootComponentSubtreeRemovalNode;
  Deleted : RootComponentSubtreeRemovalDeletedReceipt;
  Completed : RootComponentSubtreeRemovalCompletedReceipt;
};
// 
// RootComponentSubtreeRemovalRequest
// 
// Controller command durably fencing one registered child subtree.
// 
type RootComponentSubtreeRemovalRequest = record {
  component : text;
  operation_id : blob;
  target_canister_id : principal;
  expected_registry : ComponentRegistryHead;
};
// 
// RootComponentSubtreeRemovalResponse
// 
// Current durable snapshot of one monotonic subtree-removal operation.
// 
type RootComponentSubtreeRemovalResponse = record {
  component : text;
  completed_leaves : nat32;
  operation_id : blob;
  target_canister_id : principal;
  reserved_against_registry : ComponentRegistryHead;
  phase : RootComponentSubtreeRemovalPhase;
  target_status : ComponentLifecycleStatus;
  traversal_steps : nat32;
  target_parent_canister_id : principal;
  maximum_completed_leaves : nat32;
  target_role : text;
};
// 
// RootComponentSubtreeRemovalStopIntent
// 
// Exact registered leaf and sole root controller frozen before a stop call.
// 
type RootComponentSubtreeRemovalStopIntent = record {
  controller : principal;
  leaf : RootComponentSubtreeRemovalNode;
};
// 
// RootComponentSubtreeRemovalStopRequest
// 
// Controller command reconciling and stopping one exactly prepared leaf.
// 
type RootComponentSubtreeRemovalStopRequest = record {
  component : text;
  operation_id : blob;
  expected_leaf_parent_canister_id : principal;
  expected_traversal_steps : nat32;
  expected_leaf_canister_id : principal;
};
// 
// RootComponentSubtreeRemovalStoppedReceipt
// 
// Frozen stop authority plus the independently observed installed module.
// 
type RootComponentSubtreeRemovalStoppedReceipt = record {
  stop : RootComponentSubtreeRemovalStopIntent;
  observed_module_hash : blob;
};
type RootDelegationProofBatchProof = record {
  cert_hash : blob;
  issuer_pid : principal;
  proof : DelegationProof;
};
type RootIssuerPolicyResponse = record { issuer : RootIssuerPolicyView };
type RootIssuerPolicyUpsertRequest = record {
  allowed_grants : vec DelegatedRoleGrant;
  enabled : bool;
  issuer_pid : principal;
  refresh_after_ratio_bps : nat16;
  allowed_audiences : vec DelegationAudience;
  max_cert_ttl_ns : nat64;
};
type RootIssuerPolicyView = record {
  allowed_grants : vec DelegatedRoleGrant;
  enabled : bool;
  issuer_pid : principal;
  refresh_after_ratio_bps : nat16;
  allowed_audiences : vec DelegationAudience;
  max_cert_ttl_ns : nat64;
};
type RootIssuerRenewalBatchStatus = variant {
  Signing;
  Installing;
  FailedRetryable;
  Prepared;
  Signed;
  Installed;
};
type RootIssuerRenewalBatchView = record {
  cert_hash : blob;
  status : RootIssuerRenewalBatchStatus;
  failure : opt text;
  proof_epoch : nat64;
  prepared_at_ns : nat64;
  batch_id : blob;
  retry_after_ns : opt nat64;
  installed_at_ns : opt nat64;
  expires_at_ns : nat64;
};
type RootIssuerRenewalStateView = record {
  last_installed_cert_hash : opt blob;
  last_installed_refresh_after_ns : opt nat64;
  updated_at_ns : nat64;
  issuer_pid : principal;
  next_attempt_after_ns : nat64;
  template_fingerprint : blob;
  last_installed_expires_at_ns : opt nat64;
};
type RootIssuerRenewalStatusRequest = record { issuer_pid : principal };
type RootIssuerRenewalStatusResponse = record {
  latest_batch : opt RootIssuerRenewalBatchView;
  state : opt RootIssuerRenewalStateView;
  template : opt RootIssuerRenewalTemplateView;
};
type RootIssuerRenewalTemplateResponse = record {
  template : RootIssuerRenewalTemplateView;
};
type RootIssuerRenewalTemplateView = record {
  aud : DelegationAudience;
  grants : vec DelegatedRoleGrant;
  cert_ttl_ns : nat64;
  enabled : bool;
  issuer_pid : principal;
};
// 
// RootPeerComponentAllocationRequest
// 
// Component command naming one local or cross-root idempotent peer reservation intent.
// 
type RootPeerComponentAllocationRequest = record {
  requester : PeerComponentRequester;
  operation_id : blob;
  component_spec : text;
};
type RootProof = variant {
  IcChainKeyBatchSignatureV1 : IcChainKeyBatchSignatureProofV1;
};
// One exact provisioned Component occurrence and its committed Registry identity.
type RootProvisionedGroupMember = record {
  component_registry_revision : nat64;
  member_path : vec text;
  binding : ComponentBinding;
  component_registry_content_hash : blob;
  component_spec : text;
  purpose : ComponentDeploymentPurpose;
  limits : ComponentDeploymentLimits;
};
// Complete provisioned result for one exact group placement on this root.
type RootProvisionedGroupPlacement = record {
  members : vec RootProvisionedGroupMember;
  component_group : text;
  group_placement : ComponentGroupPlacementId;
};
type RootRequestMetadata = record { request_id : blob; ttl_ns : nat64 };
// 
// RootStoreBootstrapRequest
// 
// Small bootstrap request referencing an already chunk-staged canonical manifest.
// 
type RootStoreBootstrapRequest = record { manifest_payload_size_bytes : nat64 };
// 
// RootStoreBootstrapResponse
// 
// Exact live Store evidence returned after root-side publication and verification.
// 
type RootStoreBootstrapResponse = record {
  wasm_store : principal;
  fleet_subnet_root : principal;
  catalog : vec RootStoreCatalogEntry;
  release_set : FleetSubnetRootReleaseSet;
};
// 
// RootStoreCatalogEntry
// 
// Exact release-set identity retained after live root-local Store verification.
// 
type RootStoreCatalogEntry = record {
  role : text;
  payload_size_bytes : nat64;
  // SHA-256 of the raw Wasm qualified by the release set.
  raw_module_hash : blob;
  // SHA-256 of the exact gzip payload retained by the Store.
  payload_hash : blob;
};
type RuntimeAuthStatusSummary = record {
  auth_features : vec RuntimeFeatureStatus;
};
type RuntimeBlobStorageStatusSummary = record {
  blob_storage_features : vec RuntimeFeatureStatus;
};
type RuntimeBuildInfo = record {
  canister_version : nat64;
  canic_version : text;
  package_version : text;
  package_name : text;
};
type RuntimeCheck = record {
  status : RuntimeCheckStatus;
  subject : text;
  source : text;
  code : text;
  next : opt text;
  detail : text;
  category : text;
};
// 
// RuntimeCheckStatus
// 
type RuntimeCheckStatus = variant { fail; pass; warn; not_evaluated };
type RuntimeDiagnostic = record {
  subject : text;
  source : text;
  code : text;
  next : opt text;
  detail : text;
  category : text;
  severity : RuntimeDiagnosticSeverity;
};
// 
// RuntimeDiagnosticSeverity
// 
type RuntimeDiagnosticSeverity = variant {
  warning;
  blocked;
  info;
  unsupported;
};
type RuntimeFeatureStatus = record {
  source : text;
  name : text;
  enabled : bool;
  visibility : RuntimeFieldVisibility;
};
// 
// RuntimeFieldVisibility
// 
type RuntimeFieldVisibility = variant {
  disabled;
  feature_gated;
  controller_only;
  public_safe;
  operator_only;
};
type RuntimeReceiptCapacityStatus = record {
  status : RuntimeCheckStatus;
  next_terminal_eligibility_at_ns : opt nat64;
  receipt_records : nat64;
  terminal_application_receipt_records : nat64;
  remaining_receipt_record_headroom : nat64;
  warning_headroom_threshold : nat64;
  source : text;
  reserved_terminal_slots : nat64;
  canic_owned_receipt_records : nat64;
  resource_total_record_limit : nat64;
  receipt_record_limit : nat64;
  reserved_terminal_pages : nat64;
  resource_total_records : nat64;
  application_receipt_records : nat64;
  pending_application_receipt_records : nat64;
  remaining_resource_total_headroom : nat64;
};
// 
// RuntimeStateDomainStatus
// 
type RuntimeStateDomainStatus = variant { ok; warning; failing; not_evaluated };
type RuntimeStateDomainSummary = record {
  status : RuntimeStateDomainStatus;
  domain : text;
  storage : text;
  memory_id : opt nat8;
  version : nat32;
};
type RuntimeStateSummary = record {
  domains : vec RuntimeStateDomainSummary;
  total_stable_memory_pages : opt nat64;
  manifest_schema_version : nat32;
};
// 
// RuntimeStatus
// 
type RuntimeStatus = variant { ok; failing; degraded; unknown };
type RuntimeTopologyStatus = record {
  source : text;
  root : opt principal;
  subnet : opt principal;
  parent : opt principal;
};
type RuntimeVisibilityEntry = record {
  field : text;
  visibility : RuntimeFieldVisibility;
};
type SetStateResponse = record {
  previous : FleetStatus;
  current : FleetStatus;
  changed : bool;
};
type SetStateResponse_1 = record {
  previous : bool;
  current : bool;
  changed : bool;
};
type SignedRoleAttestation = record {
  root_proof : IssuerProof;
  payload : RoleAttestation;
};
type TemplateChunkInput = record {
  chunk_index : nat32;
  template_id : text;
  version : text;
  bytes : blob;
};
type TemplateChunkSetInfoResponse = record { chunk_hashes : vec blob };
type TemplateChunkSetPrepareInput = record {
  payload_size_bytes : nat64;
  chunk_hashes : vec blob;
  template_id : text;
  version : text;
  payload_hash : blob;
};
// 
// TemplateChunkingMode
// 
type TemplateChunkingMode = variant { Chunked; Inline };
type TemplateManifestInput = record {
  role : text;
  payload_size_bytes : nat64;
  manifest_state : TemplateManifestState;
  approved_at : opt nat64;
  created_at : nat64;
  template_id : text;
  version : text;
  store_binding : text;
  chunking_mode : TemplateChunkingMode;
  payload_hash : blob;
};
// 
// TemplateManifestState
// 
type TemplateManifestState = variant { Blocked; Staged; Approved };
type TemplateStagingStatusResponse = record {
  payload_size : text;
  expected_chunk_count : nat32;
  role : text;
  payload_size_bytes : nat64;
  publishable : bool;
  stored_chunk_count : nat32;
  template_id : text;
  version : text;
  store_binding : text;
  chunk_set_present : bool;
  chunking_mode : TemplateChunkingMode;
};
// Bounded, runtime-epoch observations for one timer callback role.
// 
// Samples cover the complete accepted shared-runtime callback path rather
// than isolating the consumer function from registry and completion work.
type TimerCallbackPerformanceStatus = record {
  maximum_stable_memory_growth_pages : opt nat64;
  memory_page_samples_since_runtime_start : nat64;
  instruction_samples_since_runtime_start : nat64;
  instructions_total_since_runtime_start : nat64;
  memory_pages_latest : opt TimerMemoryPageSampleStatus;
  instructions_latest : opt nat64;
  instructions_maximum : opt nat64;
  maximum_wasm_memory_growth_pages : opt nat64;
};
// 
// TimerExecutionOutcome
// 
type TimerExecutionOutcome = variant {
  invariant_failure;
  no_work;
  unacknowledged;
  success;
  retryable_failure;
};
// Runtime high-water memory extents measured in 64-KiB pages.
type TimerMemoryPageExtentStatus = record {
  wasm_pages : nat64;
  stable_pages : nat64;
};
// Wasm and stable-memory page extents bracketing one completed callback.
type TimerMemoryPageSampleStatus = record {
  end : TimerMemoryPageExtentStatus;
  start : TimerMemoryPageExtentStatus;
};
// 
// TimerProcessCondition
// 
type TimerProcessCondition = variant {
  active;
  retrying;
  idle;
  disabled;
  failed;
  missing_registration;
};
// 
// TimerRegistrationStatus
// 
type TimerRegistrationStatus = variant { scheduled; unregistered; running };
// 
// TimerSchedulingMode
// 
type TimerSchedulingMode = variant {
  once;
  deadline;
  after_completion;
  continuation;
  retry;
  watchdog;
};
type WasmStoreAdminCommand = variant { PublishActiveReleaseSet };
type WasmStoreAdminResponse = variant { PublishedActiveReleaseSet };
type WasmStoreBootstrapDebugResponse = record {
  staged : vec TemplateStagingStatusResponse;
  ready_for_bootstrap : bool;
  bootstrap : opt TemplateStagingStatusResponse;
};
// 
// WasmStoreGcMode
// 
type WasmStoreGcMode = variant {
  Clearing;
  Complete;
  Normal;
  Prepared;
  InProgress;
};
type WasmStoreGcStatusResponse = record {
  prepared_at : opt nat64;
  changed_at : nat64;
  mode : WasmStoreGcMode;
  runs_completed : nat32;
  completed_at : opt nat64;
  started_at : opt nat64;
};
type WasmStoreOverviewResponse = record {
  stores : vec WasmStoreOverviewStoreResponse;
  publication : WasmStorePublicationStateResponse;
};
type WasmStoreOverviewStoreResponse = record {
  gc : WasmStoreGcStatusResponse;
  pid : principal;
  approved_templates : vec WasmStoreTemplateStatusResponse;
  headroom_bytes : opt nat64;
  approved_payload_size : text;
  remaining_approved_payload_bytes : nat64;
  max_store_bytes : nat64;
  created_at : nat64;
  max_template_versions_per_template : opt nat16;
  max_templates : opt nat32;
  remaining_approved_payload_size : text;
  within_approved_headroom : bool;
  binding : text;
  approved_release_count : nat32;
  headroom_size : opt text;
  approved_payload_bytes : nat64;
  max_store_size : text;
  publication_slot : opt WasmStorePublicationSlotResponse;
  approved_template_count : nat32;
};
type WasmStorePublicationSlotResponse = variant { Detached; Active; Retired };
type WasmStorePublicationStateResponse = record {
  retired_binding : opt text;
  changed_at : nat64;
  generation : nat64;
  retired_at : nat64;
  active_binding : opt text;
  detached_binding : opt text;
};
type WasmStoreTemplateStatusResponse = record {
  template_id : text;
  versions : nat16;
};
