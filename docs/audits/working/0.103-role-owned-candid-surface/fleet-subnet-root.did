};
// Controller command for explicit pool maintenance.
type PoolAdminCommand = variant {
  RetryRefill;
  Handoff : record { canister_id : principal; recipient : principal };
  RetryReset : record { canister_id : principal };
  Import : record { canister_id : principal };
  Maintain;
};
// Result of one explicit pool maintenance command.
type PoolAdminResponse = variant {
  Imported : record { canister_id : principal };
  HandedOff : record { canister_id : principal; recipient : principal };
  RefillRetryScheduled : record { previous_operation_id : blob };
  ResetQueued : record { canister_id : principal };
  RefillWaitingForCycles : record { creation_amount : nat; available : nat };
  ResetFailed : record { canister_id : principal; reason : text };
  RefillPending : record { operation_id : blob; uncertain_result : bool };
  Maintained;
  RefillBlocked : record {
    failure : CanisterPoolCreationFailure;
    operation_id : blob;
  };
  MaintenancePaused : record { reason : text };
  ResetReady : record { canister_id : principal };
  Created : record { canister_id : principal };
};
