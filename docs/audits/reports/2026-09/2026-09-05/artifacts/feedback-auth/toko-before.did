type AcknowledgePlacementReceiptRequest = record {
  metadata : opt RootRequestMetadata;
  operation_id : blob;
};
// Durable phase of one authority canister's restore fence.
type AuthorityRestoreFencePhase = variant { Open; Sealed };
// Current durable authority snapshot/restore-fence state.
type AuthorityRestoreFenceStatusResponse = record {
  history_total_num_changes : opt nat64;
  authority_canister : principal;
  operation_id : opt blob;
  phase : AuthorityRestoreFencePhase;
  changed_at_ns : opt nat64;
};
// Controller-selected identity for one authority snapshot operation.
type AuthoritySnapshotRequest = record { operation_id : blob };
type BootstrapStatusResponse = record {
  last_error : opt text;
  phase : text;
  ready : bool;
};
//
// BuildNetwork
//
// Identifies the network class the canister was built for.
// Owned by ids and consumed by build-network config and access checks.
//
type BuildNetwork = variant { ic; local };
type CanicHealthStatus = record {
  status : HealthStatus;
  observed_at_ns : opt nat64;
  schema_version : nat32;
  checks : vec RuntimeCheck;
};
type CanicMetadataResponse = record {
  package_description : text;
  canister_version : nat64;
  canic_version : text;
  package_version : text;
  package_name : text;
};
type CanicReadinessStatus = record {
  status : ReadinessStatus;
  blockers : vec RuntimeDiagnostic;
  role : opt text;
  observed_at_ns : nat64;
  schema_version : nat32;
  warnings : vec RuntimeDiagnostic;
  checks : vec RuntimeCheck;
};
type CanicRuntimeStatus = record {
  status : RuntimeStatus;
  timer_inventory : RuntimeCheck;
  features : vec RuntimeFeatureStatus;
  timers : vec CanisterTimerStatus;
  blob_storage : opt RuntimeBlobStorageStatusSummary;
  auth : opt RuntimeAuthStatusSummary;
  role : opt text;
  root : opt principal;
  observed_at_ns : nat64;
  canister_id : principal;
  schema_version : nat32;
  state : opt RuntimeStateSummary;
  build_network : opt BuildNetwork;
  build : RuntimeBuildInfo;
  receipt_capacity : opt RuntimeReceiptCapacityStatus;
  visibility : vec RuntimeVisibilityEntry;
  recent_failures : vec RecentFailure;
  topology : opt RuntimeTopologyStatus;
  readiness : CanicReadinessStatus;
};
type CanisterInfo = record {
  pid : principal;
  role : text;
  created_at : nat64;
  module_hash : opt blob;
  parent_pid : opt principal;
};
// Exact sensitive runtime observation selected by an authenticated controller path.
type CanisterObservabilityRequest = variant {
  CycleHistory : PageRequest;
  CycleTopups : PageRequest;
  Metrics : MetricsStatusRequest;
  CycleBalance;
};
// Exact sensitive runtime observation returned to an authenticated controller path.
type CanisterObservabilityResponse = variant {
  CycleHistory : Page;
  CycleTopups : Page_1;
  Metrics : Page_2;
  CycleBalance : CycleBalanceStatusResponse;
};
// Controller-visible inventory row for one root-owned physical Canister.
type CanisterPoolAsset = record {
  status : CanisterPoolAssetStatus;
  added_at_ns : nat64;
  origin : CanisterPoolAssetOrigin;
  canister_id : principal;
  updated_at_ns : nat64;
  cycles : nat;
  creation_receipt : opt CanisterPoolCreationReceipt;
};
// How one physical Canister entered the root-owned inventory.
type CanisterPoolAssetOrigin = variant {
  Imported;
  Recycled;
  Created;
  InfrastructureStore;
};
// Current durable state of one root-owned physical Canister.
type CanisterPoolAssetStatus = variant {
  Store;
  Failed : record { reason : text };
  Claimed : record { claim : CanisterPoolClaim };
  StoreDeletionPending : OperationReceipt;
  PendingReset;
  HandingOff : record { recipient : principal };
  Ready;
  Recycling : record {
    claim : CanisterPoolClaim;
    reset : CanisterPoolRecycleReset;
  };
  Workload : record { claim : CanisterPoolClaim };
};
// Identifies the durable Component allocation that has claimed one empty Canister.
type CanisterPoolClaim = record { component : text; operation_id : blob };
// Exact Cycles Ledger request retained until its principal is in inventory.
type CanisterPoolCreation = record {
  placement_subnet : principal;
  ledger_amount : nat;
  created_at_time_ns : nat64;
  root : principal;
  readiness_floor : nat;
  operation_id : blob;
  attempt_count : nat32;
  progress : CanisterPoolCreationProgress;
  creation_execution_margin : nat;
  ledger_fee : nat;
  management_creation_fee : nat;
  last_attempt_at_ns : opt nat64;
  cycles_ledger : principal;
};
// Why one autonomous refill stopped without creating another Canister.
type CanisterPoolCreationFailure = variant {
  UnresolvedAfterLedgerWindow;
  LedgerRejected;
  LedgerCreationFailed;
};
// Durable controller-visible progress of one autonomous refill.
type CanisterPoolCreationProgress = variant {
  Blocked : record { failure : CanisterPoolCreationFailure };
  WaitingForFunding : record {
    retry_at_ns : nat64;
    observed_at_ns : nat64;
    attempt_count : nat32;
    available : nat;
    shortfall : nat;
    required : nat;
    last_attempt_at_ns : opt nat64;
  };
  Intent : record { uncertain_result : bool };
  Created : record { block_index : nat64; canister_id : principal };
};
// Exact Cycles Ledger receipt retained for one autonomously created pool asset.
type CanisterPoolCreationReceipt = record {
  ledger_amount : nat;
  block_index : nat64;
  readiness_floor : nat;
  operation_id : blob;
  first_observed_cycles : opt nat;
  creation_execution_margin : nat;
  ledger_fee : nat;
  management_creation_fee : nat;
  cycles_ledger : principal;
};
// Durable transfer of one paid asset to replacement authority during root draining.
type CanisterPoolHandoff = record {
  prepared_at_ns : nat64;
  canister_id : principal;
  recipient : principal;
};
// Reset outcome retained while a stopped workload is still Registry-owned.
type CanisterPoolRecycleReset = variant {
  Failed : record { reason : text };
  Ready;
  Pending;
};
// Exact pool policy and current exclusive root-owned physical inventory.
type CanisterPoolResponse = record {
  workload : nat32;
  recycling : nat32;
  claimed : nat32;
  surplus : nat32;
  completed_handoffs : nat64;
  entries : vec CanisterPoolAsset;
  pending_handoff : opt CanisterPoolHandoff;
  store : nat32;
  tracked : nat32;
  pending_reset : nat32;
  config : FleetSubnetCanisterPoolConfig;
  handing_off : nat32;
  ready : nat32;
  failed : nat32;
  pending_creation : opt CanisterPoolCreation;
  pooled : nat32;
  store_deletion_pending : nat32;
  next_start_after : opt principal;
};
// Bounded controller query for one canonical inventory page.
type CanisterPoolStatusRequest = record {
  start_after : opt principal;
  limit : nat16;
};
type CanisterSettings = record {
  freezing_threshold : nat;
  wasm_memory_threshold : nat;
  environment_variables : vec EnvironmentVariable;
  controllers : vec principal;
  reserved_cycles_limit : nat;
  log_visibility : LogVisibility;
  log_memory_limit : nat;
  wasm_memory_limit : nat;
  memory_allocation : nat;
  compute_allocation : nat;
};
type CanisterStatusResponse = record {
  memory_metrics : MemoryMetrics;
  status : CanisterStatusType;
  memory_size : nat;
  cycles : nat;
  settings : CanisterSettings;
  query_stats : QueryStats;
  idle_cycles_burned_per_day : nat;
  module_hash : opt blob;
  reserved_cycles : nat;
};
//
// CanisterStatusType
//
type CanisterStatusType = variant { stopped; stopping; running };
// One live or retained registration from the shared canister timer registry.
//
// A transient `RemoveWhenStopped` registration is absent after reaching its
// terminal state; its final observation is therefore not retained here.
type CanisterTimerStatus = record {
  invariant_failures_since_runtime_start : nat64;
  work_performance : TimerCallbackPerformanceStatus;
  stale_callbacks_since_runtime_start : nat64;
  scheduler_performance : TimerCallbackPerformanceStatus;
  scheduling_mode : TimerSchedulingMode;
  owner : text;
  registration : TimerRegistrationStatus;
  name : text;
  consecutive_expected_failures : nat64;
  generation : opt nat64;
  enabled : bool;
  schedules_since_runtime_start : nat64;
  last_work_count : nat64;
  executions_since_runtime_start : nat64;
  expected_failures_since_runtime_start : nat64;
  last_outcome : opt TimerExecutionOutcome;
  successes_since_runtime_start : nat64;
  last_failure_at_ns : opt nat64;
  subsystem : text;
  next_due_at_ns : opt nat64;
  last_success_at_ns : opt nat64;
  condition : TimerProcessCondition;
};
type CapabilityProof = variant { Structural };
type CapabilityRequestMetadata = record {
  request_id : blob;
  ttl_ns : nat64;
  issued_at_ns : nat64;
};
type CapabilityService = variant { Root };
type ChainKeyAlgorithm = variant { EcdsaSecp256k1 };
type ChainKeyBatchHeaderV1 = record {
  root_canister_id : principal;
  registry_epoch : nat64;
  algorithm : ChainKeyAlgorithm;
  key_version : nat64;
  key_id : ChainKeyKeyId;
  registry_hash : blob;
  proof_epoch : nat64;
  batch_id : blob;
  not_before_ns : nat64;
  schema_version : nat16;
  derivation_path_hash : blob;
  tree_root : blob;
  expires_at_ns : nat64;
};
type ChainKeyBatchWitnessStepV1 = variant {
  RightSibling : blob;
  LeftSibling : blob;
};
type ChainKeyBatchWitnessV1 = record { steps : vec ChainKeyBatchWitnessStepV1 };
type ChainKeyDelegationCertV1 = record {
  root_canister_id : principal;
  registry_epoch : nat64;
  grants : vec DelegatedRoleGrant;
  max_token_ttl_ns : nat64;
  issuer_proof_binding_hash : blob;
  registry_hash : blob;
  proof_epoch : nat64;
  issuer_proof_binding : IssuerProofBinding;
  audience : DelegationAudience;
  not_before_ns : nat64;
  issuer_canister_id : principal;
  issuer_proof_algorithm : IssuerProofAlgorithm;
  expires_at_ns : nat64;
};
type ChainKeyKeyId = record { name : text };
type ChainKeyRootSignatureV1 = record {
  algorithm : ChainKeyAlgorithm;
  signature : blob;
  public_key : blob;
  key_id : ChainKeyKeyId;
  derivation_path : vec blob;
};
//
// ComponentBinding
//
// Complete immutable identity and placement of one concrete Component.
//
type ComponentBinding = record {
  placement_subnet : principal;
  component : text;
  role : text;
  canister_id : principal;
  fleet_subnet_root : principal;
  authority : FleetRegistryAuthority;
  component_spec : text;
  spec_hash : blob;
};
//
// ComponentChildBinding
//
// Complete immutable identity of one child at any depth in one exact Component tree.
//
type ComponentChildBinding = record {
  component : ComponentBinding;
  parent_canister_id : principal;
  role : text;
  canister_id : principal;
};
//
// ComponentChildKind
//
// Lifecycle class for a managed Component child at any tree depth.
//
type ComponentChildKind = variant { instance; shard; replica; singleton };
// One bounded inert metadata label on a flattened Component occurrence.
type ComponentDeploymentLabel = record { key : text; value : text };
// Fully effective quotas inherited by every placement of one member occurrence.
type ComponentDeploymentLimits = record {
  maximum_descendants : nat32;
  maximum_registry_bytes : nat64;
  spawn_grant_reductions : vec ComponentDeploymentSpawnGrantLimit;
};
// Exact typed purpose resolved for one flattened deployment occurrence.
type ComponentDeploymentPurpose = variant {
  FleetServiceMember : record {
    "service" : text;
    member_purpose : FleetServiceMemberPurpose;
  };
  Ordinary;
};
// Canonical reduced ceiling for one exact Component Spec spawn grant.
type ComponentDeploymentSpawnGrantLimit = record {
  child_role : text;
  maximum_instances_per_parent : nat32;
  parent_role : text;
};
//
// ComponentDirectoryChildEntry
//
// One authoritative normalized child projected with its complete protected binding.
//
type ComponentDirectoryChildEntry = record {
  status : ComponentLifecycleStatus;
  kind : ComponentChildKind;
  protocol_profile_digest : blob;
  binding : ComponentChildBinding;
  installed_artifact_hash : blob;
};
//
// ComponentDirectoryHead
//
// Compact independently versioned discovery projection for one Component tree.
//
type ComponentDirectoryHead = record {
  provenance : ComponentDirectoryProvenance;
  descendant_count : nat32;
};
//
// ComponentDirectoryHeadRequest
//
// Read-only lookup key for one committed Component Directory head.
//
type ComponentDirectoryHeadRequest = record { component : text };
//
// ComponentDirectoryPageRequest
//
// Bounded member query against one exact current Component Directory authority.
//
type ComponentDirectoryPageRequest = record {
  status : opt ComponentLifecycleStatus;
  directory : ComponentDirectoryHead;
  parent_canister_id : opt principal;
  cursor : opt blob;
  role : opt text;
  limit : nat16;
};
//
// ComponentDirectoryPageResponse
//
// One bounded caller-scoped page under the exact requested Directory head.
//
type ComponentDirectoryPageResponse = record {
  directory : ComponentDirectoryHead;
  entries : vec ComponentDirectoryChildEntry;
  next_cursor : opt blob;
};
//
// ComponentDirectoryProvenance
//
// Exact Component Registry authority from which one Component Directory is derived.
//
type ComponentDirectoryProvenance = record {
  component : ComponentBinding;
  component_registry_revision : nat64;
  source_fleet_subnet_root : principal;
  component_registry_content_hash : blob;
  synchronized_at_ns : nat64;
};
// Compact proof of one exact Component Directory delivered during publication.
type ComponentDirectoryPublicationEvidence = record {
  component : text;
  content_hash : blob;
};
// Compact proof of one exact Component Group Directory delivered during publication.
type ComponentGroupDirectoryPublicationEvidence = record {
  content_hash : blob;
  group_placement : ComponentGroupPlacementId;
};
// Durable Fleet-scoped identity of one materialized Component Group deployment copy.
type ComponentGroupPlacementId = record { deployment : text; ordinal : nat32 };
// One materialized copy of a completely flattened Component Group.
type ComponentGroupPlacementPlan = record {
  component_group : text;
  entries : vec ComponentGroupPlanEntry;
  group_placement : ComponentGroupPlacementId;
};
// One exact top-level Component occurrence within a group placement.
type ComponentGroupPlanEntry = record {
  labels : vec ComponentDeploymentLabel;
  member_path : vec text;
  component_spec : text;
  spec_hash : blob;
  purpose : ComponentDeploymentPurpose;
  limits : ComponentDeploymentLimits;
};
//
// ComponentLifecycleStatus
//
// Root-owned runtime lifecycle state of one committed Component Registry member.
//
type ComponentLifecycleStatus = variant { Draining; Active; Prepared; Removed };
//
// ComponentProvisioningGrant
//
// Non-parent authorization for one requester Spec to create one exact peer Spec.
//
type ComponentProvisioningGrant = record {
  requester_component_spec : text;
  maximum_instances_per_requester_per_root : nat32;
  target_component_spec : text;
};
//
// ComponentProvisioningOrigin
//
// Authenticated causal authority retained with one top-level Component allocation.
//
type ComponentProvisioningOrigin = variant {
  FleetAdministrator : record { caller : principal };
  ComponentGroup : record {
    plan_hash : blob;
    operation_id : blob;
    member_path : vec text;
    group_placement : ComponentGroupPlacementId;
  };
  Component : record {
    requester : ComponentBinding;
    grant : ComponentProvisioningGrant;
  };
  FleetServiceComponent : record {
    requester : FleetServiceComponentRequester;
    grant : ComponentProvisioningGrant;
    registry : FleetRegistryVersion;
  };
};
//
// ComponentRegistryActivePartitionRequest
//
// Exact top-level allocation authority whose immutable activation partition and current head are
// required for terminal Fleet inventory.
//
type ComponentRegistryActivePartitionRequest = record {
  component : text;
  plan_hash : blob;
  member_path : vec text;
  provisioning_operation_id : blob;
  group_placement : ComponentGroupPlacementId;
};
//
// ComponentRegistryActivePartitionResponse
//
// Root-qualified immutable top-level activation receipt plus the validated current partition.
// Later descendant work may advance `current` without changing `activation`.
//
type ComponentRegistryActivePartitionResponse = record {
  allocation_operation_id : blob;
  prepared : ComponentRegistryPartitionResponse;
  activation : ComponentRegistryPartitionResponse;
  current : ComponentRegistryPartitionResponse;
};
//
// ComponentRegistryHead
//
// Exact independently versioned authority of one Component Registry partition.
//
type ComponentRegistryHead = record {
  component : text;
  content_hash : blob;
  revision : nat64;
};
//
// ComponentRegistryPartitionResponse
//
// Protected top-level row and independent head of one Component Registry partition.
//
type ComponentRegistryPartitionResponse = record {
  status : ComponentLifecycleStatus;
  head : ComponentRegistryHead;
  provisioning_origin : ComponentProvisioningOrigin;
  protocol_profile_digest : blob;
  binding : ComponentBinding;
  reserved_descendants : nat32;
  committed_descendants : nat32;
  encoded_bytes : nat64;
  release_set : FleetSubnetRootReleaseSet;
};
//
// ComponentRuntimeActivationEvidence
//
// Exact retained Directory authority under which one Component runtime became Active.
//
type ComponentRuntimeActivationEvidence = record {
  activated_at_ns : nat64;
  directory_authority_hash : blob;
};
//
// ComponentSpecAdmission
//
// Immutable permission and concrete-instance ceiling for one Spec on one Fleet Subnet Root.
//
type ComponentSpecAdmission = record {
  maximum_root_instances : nat32;
  component_spec : text;
  spec_hash : blob;
};
// Named response for the protected compiled configuration source.
type ConfigStatusResponse = record { toml : text };
type CreateCanisterParent = variant {
  ThisCanister;
  Parent;
  Root;
  Canister : principal;
  Directory : text;
};
type CreateCanisterRequest = record {
  metadata : opt RootRequestMetadata;
  extra_arg : opt blob;
  canister_role : text;
  parent : CreateCanisterParent;
};
type CreateCanisterResponse = record { new_canister_pid : principal };
// Named response for the canister's current cycle balance.
type CycleBalanceStatusResponse = record { cycles : nat };
// Exact input shared by the Root's preview and durable refill commands.
type CycleRefillInput = record {
  source_subaccount : opt blob;
  operation_id : blob;
  amount_e8s : nat64;
};
type CycleTopupEvent = record {
  status : CycleTopupEventStatus;
  error : opt text;
  requested_cycles : nat;
  timestamp_secs : nat64;
  transferred_cycles : opt nat;
  sequence : nat32;
};
//
// CycleTopupEventStatus
//
type CycleTopupEventStatus = variant {
  RequestScheduled;
  RequestOk;
  RequestErr;
};
type CycleTrackerEntry = record { cycles : nat; timestamp_secs : nat64 };
//
// CyclesFundingBudget
//
// Positive aggregate cycles-funding ceiling applied over one bounded window.
//
type CyclesFundingBudget = record { window_secs : nat64; maximum_cycles : nat };
type CyclesFundingPreflightResponse = variant {
  CooldownActive : record { retry_after_secs : nat64 };
  ChildBudgetExhausted : record {
    max_per_child : nat;
    remaining_child_budget : nat;
  };
  ParentFundingUnavailable : record { approved_cycles : nat };
};
type CyclesRequest = record {
  metadata : opt RootRequestMetadata;
  cycles : nat;
};
type CyclesResponse = variant {
  Transferred : record { cycles_transferred : nat };
  PreflightRejected : CyclesFundingPreflightResponse;
};
type DelegatedRoleGrant = record { scopes : vec text; target : text };
type DelegationAudience = variant { Fleet : FleetKey };
type DelegationCert = record {
  aud : DelegationAudience;
  grants : vec DelegatedRoleGrant;
  max_token_ttl_ns : nat64;
  issuer_proof_binding_hash : blob;
  issuer_proof_binding : IssuerProofBinding;
  not_before_ns : nat64;
  issued_at_ns : nat64;
  issuer_pid : principal;
  issuer_proof_alg : IssuerProofAlgorithm;
  expires_at_ns : nat64;
  root_pid : principal;
};
type DelegationProof = record { cert : DelegationCert; root_proof : RootProof };
type EnvironmentVariable = record { value : text; name : text };
//
// Error
//
// Public API error payload. Only registered runtime reasons may originate a
// value; Candid/Serde decoding may still preserve any raw `u16`.
//
type Error = record { code : nat16 };
//
// FailureSeverity
//
type FailureSeverity = variant { warning; info; error; critical };
//
// FleetActivationIdentity
//
type FleetActivationIdentity = record {
  fleet : FleetBinding;
  operation_id : blob;
  release_build_id : text;
};
//
// FleetActivationPhase
//
type FleetActivationPhase = variant { Active; Prepared };
type FleetActivationResumeRequest = record {
  credential : FleetCredentialGenerationRef;
  operation_id : blob;
};
//
// FleetActivationStatusResponse
//
type FleetActivationStatusResponse = record {
  activated_at_ns : opt nat64;
  cascade_manifest : opt vec FleetCascadeManifestEntry;
  credential : opt FleetCredentialGenerationRef;
  cascade : opt FleetCascadeActivationEvidence;
  credential_manifest : opt FleetCredentialManifest;
  identity : FleetActivationIdentity;
  phase : FleetActivationPhase;
};
// Coordinator-authenticated command that advances one fully fenced Root subtree to activation.
type FleetAdmissionActivateRootRequest = record {
  operation_id : blob;
  expected_policy_digest : blob;
  expected_generation : nat64;
  successor_policy_digest : blob;
  successor_generation : nat64;
  authority : FleetCoordinatorBinding;
};
// Coordinator-authenticated command that opens one fully activated Root subtree.
type FleetAdmissionOpenRootRequest = record {
  policy_digest : blob;
  generation : nat64;
  operation_id : blob;
  authority : FleetCoordinatorBinding;
};
// One exact Coordinator-owned Fleet admission policy.
type FleetAdmissionPolicy = record {
  policy_digest : blob;
  fleet : FleetBinding;
  generation : nat64;
  schema_version : nat16;
  fleet_principals : vec principal;
  rules : vec FleetAdmissionRule;
};
// Coordinator-authenticated staged Root catalog reservation or fencing command.
type FleetAdmissionPrepareRootRequest = record {
  successor : FleetAdmissionPolicy;
  operation_id : blob;
  expected_policy_digest : blob;
  stage : FleetAdmissionPrepareRootStage;
  expected_generation : nat64;
  authority : FleetCoordinatorBinding;
};
// Coordinator-authenticated command that snapshots one Root subtree and starts fencing it.
type FleetAdmissionPrepareRootStage = variant { Release; Reserve; Fence };
// Monotonic target phase exposed through protected Root admission status.
type FleetAdmissionRootParticipantPhase = variant {
  Open;
  Prepared;
  Activated;
  Pending;
};
// One bounded target progress row owned only by its Root journal.
type FleetAdmissionRootParticipantStatus = record {
  last_receipt_hash : opt blob;
  target : ManagedCanisterBinding;
  projection_digest : blob;
  phase : FleetAdmissionRootParticipantPhase;
};
// Exact aggregate Root receipt returned after every subtree phase converges.
type FleetAdmissionRootReceipt = record {
  policy_digest : blob;
  root : FleetSubnetRootBinding;
  generation : nat64;
  participant_catalog_digest : blob;
  operation_id : blob;
  receipt_hash : blob;
  phase : FleetAdmissionRootTransitionPhase;
  participant_count : nat32;
};
// Protected bounded view of the Root's current or retained admission operation.
type FleetAdmissionRootStatusResponse = record {
  participants : Page_3;
  active_generation : nat64;
  participant_catalog_digest : opt blob;
  last_result : opt FleetAdmissionRootReceipt;
  operation_id : opt blob;
  active_policy_digest : blob;
  successor_policy_digest : opt blob;
  successor_generation : opt nat64;
  phase : opt FleetAdmissionRootTransitionPhase;
  maximum_page_size : nat16;
};
// Root aggregate phase retained for Coordinator response-loss replay.
type FleetAdmissionRootTransitionPhase = variant {
  Opening;
  PerimeterFenced;
  Released;
  Converged;
  Activating;
  Preparing;
};
// One canonical narrower admission rule.
type FleetAdmissionRule = record {
  selector : FleetAdmissionSelector;
  principals : vec principal;
};
// Exact policy scope selected by protected input or a controller mutation.
type FleetAdmissionSelector = variant {
  fleet;
  component_instance : text;
  fleet_subnet_root : principal;
  component_spec : text;
};
//
// FleetBinding
//
// Immutable binding between one installed Fleet and its source App.
//
type FleetBinding = record { app : text; fleet : FleetKey };
// Root-routed request for one Root-controlled canister's sensitive observations.
type FleetCanisterObservabilityRequest = record {
  request : CanisterObservabilityRequest;
  canister_id : principal;
};
//
// FleetCascadeActivationEvidence
//
type FleetCascadeActivationEvidence = variant {
  Applied : record {
    state_snapshot_hash : blob;
    topology_snapshot_hash : blob;
  };
  Source : record { cascade_manifest_hash : blob };
};
//
// FleetCascadeManifestEntry
//
type FleetCascadeManifestEntry = record {
  "principal" : principal;
  state_snapshot_hash : blob;
  topology_snapshot_hash : blob;
};
//
// FleetCoordinatorBinding
//
// Immutable identity and exact physical placement of one Fleet Coordinator.
//
type FleetCoordinatorBinding = record {
  fleet : FleetBinding;
  coordinator_subnet : principal;
  coordinator : principal;
};
//
// FleetCredentialGenerationRef
//
type FleetCredentialGenerationRef = record {
  generation : nat64;
  manifest_hash : blob;
};
//
// FleetCredentialManifest
//
type FleetCredentialManifest = record {
  fleet : FleetKey;
  activation_id : blob;
  generation : nat64;
  root_policy_set_hash : blob;
  entries : vec FleetCredentialManifestEntry;
  renewal_template_set_hash : blob;
};
//
// FleetCredentialManifestEntry
//
type FleetCredentialManifestEntry = record {
  cert_hash : blob;
  root_issuer : principal;
  bundle_hash : blob;
  not_before_ns : nat64;
  proof_hash : blob;
  subject_canister : principal;
  expires_at_ns : nat64;
  key_identity_hash : blob;
};
//
// FleetDirectoryProvenance
//
// Exact Registry authority and root that published one local Fleet Directory projection.
//
type FleetDirectoryProvenance = record {
  source_fleet_subnet_root : principal;
  registry : FleetRegistryVersion;
};
// One complete configured service projected from the canonical Fleet Registry.
//
// This is topology discovery only. Applications own health, readiness,
// replication progress, promotion, consistency and load-balancer policy.
type FleetDirectoryService = record {
  "service" : text;
  members : vec FleetDirectoryServiceComponent;
  placement : FleetServicePlacementPolicy;
  mode : FleetServiceMode;
  role : text;
  component_spec : text;
};
// One exact configured Component projected into a Fleet Directory service.
type FleetDirectoryServiceComponent = record {
  component : text;
  canister_id : principal;
  member_path : vec text;
  member_purpose : FleetServiceMemberPurpose;
  fleet_subnet_root : principal;
  group_placement : ComponentGroupPlacementId;
};
//
// FleetDirectorySnapshot
//
// Root-local read-only discovery projection derived from one exact published Registry.
//
type FleetDirectorySnapshot = record {
  provenance : FleetDirectoryProvenance;
  fleet_subnet_roots : vec FleetSubnetRootDirectoryEntry;
  services : vec FleetDirectoryService;
};
// Exact protected physical-placement evidence reviewed for one rotation.
type FleetFundingPolicyRotationPlacementEvidence = record {
  node_count : nat64;
  cost_multiplier_numerator : nat64;
  acknowledge_fiduciary_cost : bool;
  cost_multiplier_denominator : nat64;
  subnet : principal;
  fiduciary : bool;
};
// Coordinator-authored request that converges one prepared Root.
type FleetFundingPolicyRotationRootActivateRequest = record {
  successor_registry : FleetRegistryVersion;
  plan_digest : blob;
  operation_id : blob;
  successor_generation : nat64;
  fleet_subnet_root : principal;
  predecessor_generation : nat64;
  predecessor_registry : FleetRegistryVersion;
};
// Exact current and proposed authority for one affected Root.
type FleetFundingPolicyRotationRootPlan = record {
  proposed_policy : FleetSubnetRootFundingPolicy;
  placement : FleetFundingPolicyRotationPlacementEvidence;
  fleet_subnet_root : principal;
  predecessor_usage : FleetFundingPolicyUsage;
  predecessor_policy_hash : blob;
};
// Coordinator-authored request that fences one Root beneath a staged plan.
type FleetFundingPolicyRotationRootPrepareRequest = record {
  plan_digest : blob;
  root : FleetFundingPolicyRotationRootPlan;
  operation_id : blob;
  successor_generation : nat64;
  predecessor_generation : nat64;
  predecessor_registry : FleetRegistryVersion;
};
// Idempotent Root receipt for one exact rotation phase.
type FleetFundingPolicyRotationRootReceipt = record {
  activated : bool;
  plan_digest : blob;
  operation_id : blob;
  recorded_at_ns : nat64;
  prepared : bool;
  successor_generation : nat64;
  fleet_subnet_root : principal;
  predecessor_generation : nat64;
};
// Current-generation and retained predecessor automatic-funding usage.
type FleetFundingPolicyUsage = record {
  generation_automatic_cycles : nat;
  historical_automatic_grants : nat64;
  generation_automatic_grants : nat32;
  historical_automatic_cycles : nat;
};
// Protected physical-topology class that selects the minimum Root funding baseline.
type FleetFundingProfile = variant {
  multi_subnet;
  preview_multi_subnet;
  single_subnet;
};
//
// FleetKey
//
// Complete network-qualified Fleet identity.
//
type FleetKey = record { fleet_id : text; canonical_network_id : text };
//
// FleetMode
//
type FleetMode = variant { Enabled; Disabled; Readonly };
//
// FleetRegistryAuthority
//
// Exact Coordinator binding and reinstall-local authority epoch for one Fleet Registry.
//
type FleetRegistryAuthority = record {
  epoch : nat64;
  binding : FleetCoordinatorBinding;
};
//
// FleetRegistryVersion
//
// Compact immutable identity used by mirrors, acknowledgements, and journals.
//
type FleetRegistryVersion = record {
  content_hash : blob;
  authority : FleetRegistryAuthority;
  revision : nat64;
};
// Root-authored exact receipt for one fresh or replayed grant acceptance.
type FleetRootFundingAcceptanceReceipt = record {
  request : FleetRootFundingAcceptanceRequest;
  accepted_at_ns : nat64;
  fleet_subnet_root : principal;
  coordinator : principal;
};
// Coordinator-authored exact same-Root acceptance request carrying cycles.
type FleetRootFundingAcceptanceRequest = record {
  operation_sequence : nat64;
  granted_cycles : nat;
  operation_id : blob;
  policy_hash : blob;
  observed_balance : nat;
  expected_registry : FleetRegistryVersion;
};
// Terminal reason that one authenticated request transferred no cycles.
type FleetRootFundingNoGrantReason = variant {
  RootWindowExhausted;
  FundingDisabled;
  FleetAutomaticCapExhausted;
  CooldownActive;
  RootRejected;
  RootAutomaticCapExhausted;
  RootIneligible;
  RegistryStale;
  InvalidRequest;
  FleetWindowExhausted;
  CoordinatorReserveUnavailable;
  PolicyMismatch;
};
// Durable exact zero-transfer result for one Root operation.
type FleetRootFundingNoGrantReceipt = record {
  decided_at_ns : nat64;
  request : FleetRootFundingRequest;
  reason : FleetRootFundingNoGrantReason;
};
// Root-authored request for one exact Coordinator operating-cycle decision.
type FleetRootFundingRequest = record {
  operation_sequence : nat64;
  operation_id : blob;
  policy_hash : blob;
  observed_balance : nat;
  requested_cycles : nat;
  expected_registry : FleetRegistryVersion;
};
// Exact terminal outcome returned to the authenticated requesting Root.
type FleetRootFundingResponse = variant {
  NoGrant : FleetRootFundingNoGrantReceipt;
  Granted : FleetRootFundingAcceptanceReceipt;
};
//
// FleetServiceComponentRequester
//
// Registry-derived remote Fleet-service member identity retained by one target-root operation.
//
type FleetServiceComponentRequester = record {
  "service" : text;
  component : ComponentBinding;
  member_path : vec text;
  member_purpose : FleetServiceMemberPurpose;
  group_placement : ComponentGroupPlacementId;
};
// Exact semantic purpose assigned to one Fleet-service Component occurrence.
type FleetServiceMemberPurpose = variant { replica; authority; pool_member };
// Published service mode after configuration-only Authority selectors have been resolved.
type FleetServiceMode = variant { AuthorityReplica; ActivePool };
// Service-wide density and spread envelope independent of deployment placement.
type FleetServicePlacementPolicy = record {
  minimum_distinct_roots : nat32;
  maximum_members_per_root : nat32;
};
type FleetStateResponse = record {
  mode : FleetMode;
  cycles_funding_enabled : bool;
};
//
// FleetStatus
//
type FleetStatus = variant { Stopped; Active; Readonly };
//
// FleetSubnetCanisterPoolConfig
//
// Immutable prepaid empty-Canister inventory policy for one Fleet Subnet Root.
//
type FleetSubnetCanisterPoolConfig = record {
  // Ceiling for standby and operator-imported pool assets.
  //
  // Recycled assets remain tracked even when their return temporarily exceeds this target.
  maximum_size : nat32;
  // Native cycles retained above the Ready floor while a newly created asset is
  // created, inspected, controller-checked, and admitted to the pool.
  creation_execution_margin : nat;
  // Ready empty Canisters automatically maintained for the root.
  minimum_size : nat32;
  // Minimum retained balance required before a pool asset becomes Ready.
  canister_cycles : nat;
};
//
// FleetSubnetRootAuthority
//
// Exact immutable root binding, initial release set, and installed module identity.
//
type FleetSubnetRootAuthority = record {
  wasm_store_authority : FleetSubnetWasmStoreAuthority;
  expected_module_hash : blob;
  binding : FleetSubnetRootBinding;
  initial_release_set : FleetSubnetRootReleaseSet;
};
//
// FleetSubnetRootAutomaticIcpRefillPolicy
//
// Optional emergency trigger and target subordinate to one root's ICP-refill policy.
//
type FleetSubnetRootAutomaticIcpRefillPolicy = record {
  maximum_automatic_refills : nat32;
  target_balance : nat;
  maximum_automatic_refill_e8s : nat64;
  emergency_threshold : nat;
};
//
// FleetSubnetRootBinding
//
// Complete immutable identity, placement, admissions, and limits of one Fleet Subnet Root.
//
type FleetSubnetRootBinding = record {
  placement_subnet : principal;
  component_topology_digest : blob;
  fleet_subnet_root : principal;
  authority : FleetRegistryAuthority;
  component_admissions : vec ComponentSpecAdmission;
  limits : FleetSubnetRootLimits;
  funding : FleetSubnetRootFundingAuthority;
};
//
// FleetSubnetRootCanisterSummary
//
// Compact live inventory bound to one root's exact active Fleet Registry mirror.
//
type FleetSubnetRootCanisterSummary = record {
  placement_subnet : principal;
  fleet_registry : FleetRegistryVersion;
  status : FleetSubnetRootStatus;
  component_canisters : nat32;
  infrastructure_canisters : nat32;
  fleet_subnet_root : principal;
  total_canisters : nat32;
  pooled_canisters : nat32;
};
// Durable proof that a removed root returned excess cycles and is ready for its executor.
type FleetSubnetRootDeletionPreparationResponse = record {
  retained_cycles_target : nat;
  observed_cycles_before_reclamation : nat;
  observed_reserved_cycles : nat;
  completed_at_ns : nat64;
  observed_freezing_threshold_seconds : nat;
  prepared_at_ns : nat64;
  operation_id : blob;
  coordinator_readiness_hash : blob;
  store_deletion_hash : blob;
  final_inventory_hash : blob;
  observed_cycles_after_reclamation : nat;
  fleet_subnet_root : principal;
  coordinator_intent_hash : blob;
  cycles_reclaimed_at_ns : nat64;
  coordinator : principal;
  observed_idle_cycles_burned_per_day : nat;
};
// Root-authenticated command freezing its pre-transfer physical-deletion readiness authority.
type FleetSubnetRootDeletionReadinessIntentRequest = record {
  retained_cycles_target : nat;
  observed_cycles_before_reclamation : nat;
  observed_reserved_cycles : nat;
  observed_freezing_threshold_seconds : nat;
  prepared_at_ns : nat64;
  operation_id : blob;
  store_deletion_hash : blob;
  final_inventory_hash : blob;
  fleet_subnet_root : principal;
  observed_idle_cycles_burned_per_day : nat;
};
// Root-authenticated command recording its converged post-transfer cycle balance.
type FleetSubnetRootDeletionReadinessRequest = record {
  expected_intent_hash : blob;
  operation_id : blob;
  observed_cycles_after_reclamation : nat;
  fleet_subnet_root : principal;
  cycles_reclaimed_at_ns : nat64;
};
//
// FleetSubnetRootDirectoryEntry
//
// One root placement and lifecycle status projected from the complete Fleet Registry.
//
type FleetSubnetRootDirectoryEntry = record {
  placement_subnet : principal;
  status : FleetSubnetRootStatus;
  fleet_subnet_root : principal;
};
//
// FleetSubnetRootDrainingReservationRequest
//
// Controller command serializing one root's Fleet-wide draining decision against placement.
//
type FleetSubnetRootDrainingReservationRequest = record {
  operation_id : blob;
  expected_root : FleetSubnetRootEntry;
  expected_registry : FleetRegistryVersion;
};
//
// FleetSubnetRootDrainingReservationResponse
//
// Durable Coordinator authority that must precede the target root's local draining fence.
//
type FleetSubnetRootDrainingReservationResponse = record {
  reservation_hash : blob;
  request : FleetSubnetRootDrainingReservationRequest;
  prepared_at_ns : nat64;
  coordinator : principal;
};
//
// FleetSubnetRootDrainingResponse
//
// Durable root-local admission cutoff and exact active authority frozen at that boundary.
//
type FleetSubnetRootDrainingResponse = record {
  placement_subnet : principal;
  reservation_hash : blob;
  next_allocation_sequence : nat64;
  component_topology_digest : blob;
  started_at_ns : nat64;
  known_created_component_canisters : nat32;
  committed_component_instances : nat32;
  operation_id : blob;
  managed_descendants : nat32;
  reserved_component_instances : nat32;
  active_release_set : FleetSubnetRootReleaseSet;
  root_registry_encoded_bytes : nat64;
  active_registry : FleetRegistryVersion;
  fleet_subnet_root : principal;
};
//
// FleetSubnetRootEntry
//
// One Fleet Subnet Root's immutable placement and admission facts plus lifecycle state.
//
type FleetSubnetRootEntry = record {
  placement_subnet : principal;
  status : FleetSubnetRootStatus;
  component_topology_digest : blob;
  active_release_set : FleetSubnetRootReleaseSet;
  fleet_subnet_root : principal;
  component_admissions : vec ComponentSpecAdmission;
  limits : FleetSubnetRootLimits;
  funding : FleetSubnetRootFundingAuthority;
};
//
// FleetSubnetRootFinalInventoryResponse
//
// Exact terminal Component history and retained write-fenced Store authority.
//
type FleetSubnetRootFinalInventoryResponse = record {
  placement_subnet : principal;
  next_allocation_sequence : nat64;
  component_topology_digest : blob;
  wasm_store_release_count : nat32;
  removed_component_instances : nat32;
  wasm_store_gc_prepared_at_secs : nat64;
  wasm_store : principal;
  operation_id : blob;
  terminal_component_history_hash : blob;
  wasm_store_catalog_entries : nat32;
  active_release_set : FleetSubnetRootReleaseSet;
  root_registry_encoded_bytes : nat64;
  fleet_subnet_root : principal;
  wasm_store_template_count : nat32;
  finalized_at_ns : nat64;
  registry : FleetRegistryVersion;
  inventory_hash : blob;
  wasm_store_catalog_hash : blob;
  wasm_store_occupied_bytes : nat64;
};
//
// FleetSubnetRootFundingAuthority
//
// Complete immutable Coordinator-grant and optional ICP-refill policy for one root.
//
type FleetSubnetRootFundingAuthority = record {
  root_funding : FleetSubnetRootFundingPolicy;
  icp_refill : opt FleetSubnetRootIcpRefillPolicy;
};
//
// FleetSubnetRootFundingPolicy
//
// Immutable Coordinator-grant thresholds and budget for one registered root.
//
type FleetSubnetRootFundingPolicy = record {
  maximum_automatic_cycles : nat;
  funding_profile : FleetFundingProfile;
  target_balance : nat;
  request_threshold : nat;
  maximum_automatic_grants : nat32;
  budget : CyclesFundingBudget;
  cooldown_secs : nat64;
};
//
// FleetSubnetRootIcpRefillPolicy
//
// Immutable root-owned ICP conversion budget, balance floor, and system-Canister authority.
//
type FleetSubnetRootIcpRefillPolicy = record {
  cmc_canister_id : opt principal;
  minimum_icp_balance_e8s : nat64;
  allow_ic_system_canister_overrides : bool;
  automatic : opt FleetSubnetRootAutomaticIcpRefillPolicy;
  window_secs : nat64;
  min_xdr_permyriad_per_icp : opt nat64;
  ledger_canister_id : opt principal;
  max_refill_e8s_per_call : nat64;
  maximum_refill_e8s : nat64;
};
//
// FleetSubnetRootInitArgs
//
// Fresh-install authority plus the reinstall-local activation operation identity.
//
type FleetSubnetRootInitArgs = record {
  install_id : blob;
  wasm_store_activation : FleetSubnetWasmStoreActivationAuthority;
  authority : FleetSubnetRootAuthority;
  // Existing prepaid empty Canisters the root must validate, reset, and adopt.
  canister_pool_imports : vec principal;
};
//
// FleetSubnetRootLimits
//
// Immutable aggregate policy ceilings for one Fleet Subnet Root.
//
type FleetSubnetRootLimits = record {
  maximum_registry_bytes : nat64;
  // Maximum accepted or committed Component Group placements on this root.
  maximum_group_placements : nat32;
  maximum_wasm_store_bytes : nat64;
  maximum_component_instances : nat32;
  canister_pool : FleetSubnetCanisterPoolConfig;
  cycles_funding : CyclesFundingBudget;
};
// One selected root's complete canonical provisioning batch.
type FleetSubnetRootProvisioningBatch = record {
  placements : vec ComponentGroupPlacementPlan;
  root : FleetSubnetRootBinding;
  active_release_set : FleetSubnetRootReleaseSet;
};
//
// FleetSubnetRootRegistryMirrorActivationResponse
//
// Exact durable evidence for one root's current Registry mirror and Fleet Directory.
//
type FleetSubnetRootRegistryMirrorActivationResponse = record {
  directory : FleetDirectorySnapshot;
  version : FleetRegistryVersion;
  fleet_subnet_root : principal;
  previous_registry : FleetRegistryVersion;
};
// Controller command asking a Prepared root to synchronize and acknowledge its Registry.
type FleetSubnetRootRegistrySyncRequest = record {
  store_bootstrap : RootStoreBootstrapRequest;
  operation_id : blob;
  expected_registry : FleetRegistryVersion;
};
// Exact root-local candidate and Coordinator acknowledgement evidence.
type FleetSubnetRootRegistrySyncResponse = record {
  version : FleetRegistryVersion;
  fleet_subnet_root : principal;
  acknowledgement : FleetSubnetRootSnapshotAcknowledgement;
};
//
// FleetSubnetRootReleaseSet
//
// Exact release-build and manifest identity admitted for one Fleet Subnet Root.
//
type FleetSubnetRootReleaseSet = record {
  manifest_digest : blob;
  release_build_id : text;
};
//
// FleetSubnetRootRemovalPublicationResponse
//
// Durable response authority for one root's canonical `Draining -> Removed` transition.
//
type FleetSubnetRootRemovalPublicationResponse = record {
  final_inventory : FleetSubnetRootFinalInventoryResponse;
  version : FleetRegistryVersion;
  previous_version : FleetRegistryVersion;
};
//
// FleetSubnetRootSnapshotAcknowledgement
//
// Durable Coordinator receipt proving which root acknowledged which version.
//
type FleetSubnetRootSnapshotAcknowledgement = record {
  version : FleetRegistryVersion;
  fleet_subnet_root : principal;
};
//
// FleetSubnetRootStatus
//
// Lifecycle state of one Fleet Subnet Root in the Fleet Registry snapshot.
//
type FleetSubnetRootStatus = variant { Joining; Draining; Active; Removed };
// Durable proof that the reclaimed Store no longer occupies a publication binding slot.
type FleetSubnetRootStoreBindingFinalizationResponse = record {
  source_generation : nat64;
  finalized_at_secs : nat64;
  wasm_store : principal;
  completed_at_ns : nat64;
  finalization_hash : blob;
  operation_id : blob;
  final_inventory_hash : blob;
  finalized_generation : nat64;
  fleet_subnet_root : principal;
  reclamation_hash : blob;
};
// Durable proof that the root's reclaimed and unbound Store is physically absent.
type FleetSubnetRootStoreDeletionResponse = record {
  retained_cycles_target : nat;
  observed_cycles_before_reclamation : nat;
  wasm_store : principal;
  observed_controllers : vec principal;
  completed_at_ns : nat64;
  prepared_at_ns : nat64;
  operation_id : blob;
  binding_finalization_hash : blob;
  deletion_hash : blob;
  observed_absent_at_ns : nat64;
  observed_cycles_after_reclamation : nat;
  fleet_subnet_root : principal;
  observed_module_hash : blob;
  cycles_reclaimed_at_ns : nat64;
};
//
// FleetSubnetRootStoreReclamationResponse
//
// Durable proof that the logically removed root's retained Store completed exact GC.
//
type FleetSubnetRootStoreReclamationResponse = record {
  wasm_store : principal;
  reclaimed_release_count : nat32;
  completed_at_ns : nat64;
  operation_id : blob;
  gc_runs_completed : nat32;
  gc_prepared_at_secs : nat64;
  reclaimed_store_bytes : nat64;
  final_inventory_hash : blob;
  fleet_subnet_root : principal;
  gc_started_at_secs : nat64;
  reclamation_hash : blob;
  reclaimed_template_count : nat32;
  reclaimed_catalog_entries : nat32;
  gc_completed_at_secs : nat64;
};
// Exact child identity Root must use while activating its independently installed Store.
type FleetSubnetWasmStoreActivationAuthority = record {
  fleet : FleetBinding;
  component_topology_digest : blob;
  controllers : vec principal;
  manifest_digest : blob;
  wasm_store : principal;
  operation_id : blob;
  release_build_id : text;
  fleet_subnet_root : principal;
};
// Request the one planned sibling Store controller handoff during root preparation.
type FleetSubnetWasmStoreAdoptionRequest = record {
  operation_id : blob;
  authority : FleetSubnetWasmStoreAuthority;
};
// Terminal root-observed receipt for one sibling Store controller handoff.
type FleetSubnetWasmStoreAdoptionResponse = record {
  controllers : vec principal;
  operation_id : blob;
  adopted_at_ns : nat64;
  authority : FleetSubnetWasmStoreAuthority;
};
//
// FleetSubnetWasmStoreAuthority
//
// Exact reciprocal authority retained by one root and its host-installed sibling Store.
//
type FleetSubnetWasmStoreAuthority = record {
  placement_subnet : principal;
  wasm_store : principal;
  wasm_module_hash : blob;
  release_build_id : text;
  fleet_subnet_root : principal;
  authority : FleetRegistryAuthority;
  installation_controller : principal;
};
//
// HealthStatus
//
type HealthStatus = variant { unhealthy; healthy; degraded; unknown };
type IcChainKeyBatchSignatureProofV1 = record {
  issuer_witness : ChainKeyBatchWitnessV1;
  signature : ChainKeyRootSignatureV1;
  delegation_cert : ChainKeyDelegationCertV1;
  header : ChainKeyBatchHeaderV1;
};
//
// IcpRefillDryRun
//
type IcpRefillDryRun = record {
  fee_e8s : nat64;
  operation_id : blob;
  amount_e8s : nat64;
  xdr_permyriad_per_icp : opt nat64;
  estimated_cycles : opt nat;
};
//
// IcpRefillErrorCode
//
type IcpRefillErrorCode = variant {
  LedgerTransferFailed;
  NotifyFailed;
  Refunded;
  NotifyMaxAttempts;
  CyclesSentOverflow;
  Duplicate;
  InvalidLedgerBlockIndex;
  InvalidTransaction;
  BadFee;
  TransferWindowStale;
  Processing;
  TransactionTooOld;
};
//
// IcpRefillResponse
//
type IcpRefillResponse = record {
  status : IcpRefillStatus;
  error_message : opt text;
  operation_id : blob;
  ledger_block_index : opt nat64;
  cycles_sent : opt nat;
  error_code : opt IcpRefillErrorCode;
};
//
// IcpRefillStatus
//
type IcpRefillStatus = variant {
  NotifyProcessing;
  Failed;
  Refunded;
  Transferred;
  InvalidTransaction;
  Requested;
  Completed;
  TransactionTooOld;
};
// Durable owner that initiated one Root ICP-refill operation.
type IcpRefillTrigger = variant {
  Manual;
  Automatic : record { sequence : nat64 };
};
type IssuerProofAlgorithm = variant { IcCanisterSignatureV1 };
type IssuerProofBinding = variant {
  IcCanisterSignatureV1 : record { seed_hash : blob };
};
//
// Debug
//
type Level = variant { Ok; Error; Info; Warn; Debug };
type LogEntry = record {
  topic : opt text;
  crate_name : text;
  created_at : nat64;
  level : Level;
  message : text;
};
// Bounded log observation selector used by each role status surface.
type LogStatusRequest = record {
  topic : opt text;
  crate_name : opt text;
  page : PageRequest;
  min_level : opt Level;
};
//
// LogVisibility
//
type LogVisibility = variant {
  controllers;
  public;
  allowed_viewers : vec principal;
};
//
// ManagedCanisterBinding
//
// Immutable Registry-issued identity retained by one managed application Canister.
//
type ManagedCanisterBinding = variant {
  ComponentChild : ComponentChildBinding;
  Component : ComponentBinding;
};
type MemoryMetrics = record {
  wasm_binary_size : nat;
  wasm_chunk_store_size : nat;
  canister_history_size : nat;
  stable_memory_size : nat;
  snapshots_size : nat;
  wasm_memory_size : nat;
  global_memory_size : nat;
  custom_sections_size : nat;
};
type MetricEntry = record {
  "principal" : opt principal;
  value : MetricValue;
  labels : vec text;
};
type MetricValue = variant {
  U128 : nat;
  CountAndU64 : record { count : nat64; value_u64 : nat64 };
  Count : nat64;
};
//
// MetricsKind
//
// Metric tier selector.
//
type MetricsKind = variant {
  Storage;
  Core;
  Security;
  Platform;
  Runtime;
  Placement;
};
// Bounded metrics observation selector used by each role status surface.
type MetricsStatusRequest = record { kind : MetricsKind; page : PageRequest };
// Durable identity returned when one role-owned asynchronous command is accepted.
type OperationReceipt = record { operation_id : blob };
type Page = record { total : nat64; entries : vec CycleTrackerEntry };
type PageRequest = record { offset : nat64; limit : nat64 };
type Page_1 = record { total : nat64; entries : vec CycleTopupEvent };
type Page_2 = record { total : nat64; entries : vec MetricEntry };
type Page_3 = record {
  total : nat64;
  entries : vec FleetAdmissionRootParticipantStatus;
};
type Page_4 = record { total : nat64; entries : vec LogEntry };
type Page_5 = record { total : nat64; entries : vec CanisterInfo };
//
// PeerComponentRequester
//
// Caller-selected peer proof mode; authoritative requester facts are derived by the target root.
//
type PeerComponentRequester = variant {
  FleetService : record {
    "service" : text;
    expected_registry : FleetRegistryVersion;
  };
  SameRoot;
};
// Selects one pool Canister for an import or reset retry command.
type PoolCanisterRequest = record { canister_id : principal };
// Selects one pool Canister and its exact handoff recipient.
type PoolHandoffRequest = record {
  canister_id : principal;
  recipient : principal;
};
// Narrow result of importing one existing physical Canister.
type PoolImportResponse = variant {
  Imported : PoolCanisterRequest;
  ResetFailed : record { canister_id : principal; reason : text };
};
// Narrow result of one explicit maintenance pass.
type PoolMaintenanceResponse = variant {
  RefillWaitingForCycles : record {
    retry_at_ns : nat64;
    creation_amount : nat;
    readiness_floor : nat;
    attempt_count : nat32;
    available : nat;
    shortfall : nat;
    ledger_fee : nat;
    required : nat;
    execution_margin : nat;
    last_attempt_at_ns : opt nat64;
  };
  ResetFailed : record { canister_id : principal; reason : text };
  RefillPending : record { operation_id : blob; uncertain_result : bool };
  Maintained;
  RefillBlocked : record {
    failure : CanisterPoolCreationFailure;
    operation_id : blob;
  };
  MaintenancePaused : record { reason : text };
  ResetReady : PoolCanisterRequest;
  Created : PoolCanisterRequest;
};
// Exact result of scheduling another blocked refill attempt.
type PoolRefillRetryResponse = record { previous_operation_id : blob };
type QueryStats = record {
  response_payload_bytes_total : nat;
  num_instructions_total : nat;
  num_calls_total : nat;
  request_payload_bytes_total : nat;
};
//
// ReadinessStatus
//
type ReadinessStatus = variant { not_ready; not_evaluated; degraded; ready };
type RecentFailure = record {
  occurred_at_ns : nat64;
  code : text;
  summary : text;
  severity : FailureSeverity;
  correlation_id : opt text;
  subsystem : text;
  redacted : bool;
};
type RecycleCanisterRequest = record {
  canister_pid : principal;
  metadata : opt RootRequestMetadata;
};
type Request = variant {
  RecycleCanister : RecycleCanisterRequest;
  AcknowledgePlacementReceipt : AcknowledgePlacementReceiptRequest;
  CreateCanister : CreateCanisterRequest;
  Cycles : CyclesRequest;
  AllocatePlacementChild : CreateCanisterRequest;
};
type Response = variant {
  RecycleCanister;
  AcknowledgePlacementReceipt;
  CreateCanister : CreateCanisterResponse;
  Cycles : CyclesResponse;
};
type Result = variant { Ok : RootCommandResponse; Err : Error };
type Result_1 = variant { Ok : RootStatusResponse; Err : Error };
// Closed compiled capability identity exposed by the immutable role overview.
type RoleCapability = variant {
  Sharding;
  Scaling;
  Root;
  FleetCoordinator;
  Index;
  Icrc21;
  ChildProvisioning;
  DelegatedTokenIssuer;
  FleetAdmissionProjection;
  RootDelegation;
  RoleAttestationSigner;
  WasmStore;
  DelegatedTokenVerifier;
  RoleAttestationVerifier;
  RootControlPlane;
  Runtime;
  AutomaticTopup;
};
// Immutable role, capability, release, and bootstrap profile-verification response.
type RoleOverviewResponse = record {
  capabilities : vec RoleCapability;
  metadata : CanicMetadataResponse;
  role : text;
  bootstrap : BootstrapStatusResponse;
  protocol_profile_digest : blob;
};
type RootCapabilityEnvelopeV1 = record {
  "service" : CapabilityService;
  metadata : CapabilityRequestMetadata;
  capability_version : nat16;
  proof : CapabilityProof;
  capability : Request;
};
type RootCapabilityResponseV1 = record { response : Response };
type RootCommand = variant {
  PreviewCycleRefill : CycleRefillInput;
  PublishReleaseSet : WasmStoreAdminCommand;
  OpenFleetAdmission : FleetAdmissionOpenRootRequest;
  ImportPoolCanister : PoolCanisterRequest;
  GetOrCreateDelegationProof;
  MaintainPool;
  RemoveSubtree : RootComponentSubtreeRemovalRequest;
  PrepareComponentRegistry : RootComponentRegistryPreparationRequest;
  RetryPoolReset : PoolCanisterRequest;
  PrepareFleetActivation;
  UpsertIssuerRenewalTemplate : RootIssuerRenewalTemplateUpsertRequest;
  BootstrapStore : RootStoreBootstrapRequest;
  RespondCapability : RootCapabilityEnvelopeV1;
  RetryPoolRefill;
  RefillCycles : CycleRefillInput;
  ProvisionComponent : RootComponentAllocationRequest;
  ObserveCanister : FleetCanisterObservabilityRequest;
  InspectCanister : PoolCanisterRequest;
  SetCyclesFunding : SetCyclesFundingRequest;
  ActivateFundingPolicyRotation : FleetFundingPolicyRotationRootActivateRequest;
  ResumeAuthoritySnapshot : AuthoritySnapshotRequest;
  UpsertIssuerPolicy : RootIssuerPolicyUpsertRequest;
  SetFleetStatus : SetFleetStatusRequest;
  HandoffPoolCanister : PoolHandoffRequest;
  AdoptStore : FleetSubnetWasmStoreAdoptionRequest;
  RemoveComponent : RootComponentDrainingRequest;
  SynchronizeComponentDirectories : RootComponentDirectorySynchronizationRequest;
  SynchronizeRegistry : FleetSubnetRootRegistrySyncRequest;
  ProvisionComponents : RootComponentProvisioningAcceptanceRequest;
  RemoveRoot : RootRemovalRequest;
  ResumeFleetActivation : FleetActivationResumeRequest;
  ProvisionChild : RootComponentChildAllocationRequest;
  ProvisionPeer : RootPeerComponentAllocationRequest;
  AcceptFunding : FleetRootFundingAcceptanceRequest;
  ActivateFleetAdmission : FleetAdmissionActivateRootRequest;
  PrepareFundingPolicyRotation : FleetFundingPolicyRotationRootPrepareRequest;
  PrepareFleetAdmission : FleetAdmissionPrepareRootRequest;
  PrepareAuthoritySnapshot : AuthoritySnapshotRequest;
};
type RootCommandResponse = variant {
  PreviewCycleRefill : IcpRefillDryRun;
  PublishReleaseSet : WasmStoreAdminResponse;
  OpenFleetAdmission : FleetAdmissionRootReceipt;
  ImportPoolCanister : PoolImportResponse;
  GetOrCreateDelegationProof : RootDelegationProofBatchProof;
  MaintainPool : PoolMaintenanceResponse;
  PrepareComponentRegistry : RootComponentRegistryStatusResponse;
  RetryPoolReset : PoolCanisterRequest;
  UpsertIssuerRenewalTemplate : RootIssuerRenewalTemplateResponse;
  RespondCapability : RootCapabilityResponseV1;
  RetryPoolRefill : PoolRefillRetryResponse;
  ObserveCanister : CanisterObservabilityResponse;
  InspectCanister : CanisterStatusResponse;
  SetCyclesFunding : SetStateResponse;
  ActivateFundingPolicyRotation : FleetFundingPolicyRotationRootReceipt;
  ResumeAuthoritySnapshot : AuthorityRestoreFenceStatusResponse;
  UpsertIssuerPolicy : RootIssuerPolicyResponse;
  SetFleetStatus : SetStateResponse_1;
  HandoffPoolCanister : PoolHandoffRequest;
  SynchronizeComponentDirectories : RootComponentDirectorySynchronizationResponse;
  OperationAccepted : OperationReceipt;
  AcceptFunding : FleetRootFundingAcceptanceReceipt;
  ActivateFleetAdmission : FleetAdmissionRootReceipt;
  PrepareFundingPolicyRotation : FleetFundingPolicyRotationRootReceipt;
  PrepareFleetAdmission : FleetAdmissionRootReceipt;
  PrepareAuthoritySnapshot : AuthorityRestoreFenceStatusResponse;
};
// Compact terminal evidence binding Component inventory and root runtime activation.
type RootComponentActivationEvidence = record {
  root_activated_at_ns : nat64;
  fleet_activation_operation_id : blob;
  component_count : nat32;
  initial_inventory_hash : blob;
};
//
// RootComponentAllocationPhase
//
// Durable root-local progress of one top-level Component allocation operation.
//
type RootComponentAllocationPhase = variant {
  Committed;
  Reserved;
  InstallIntent;
  Removed;
  Created;
  Installed;
  Verified;
  CreationIntent;
};
//
// RootComponentAllocationRequest
//
// Controller command naming one idempotent top-level Component reservation intent.
//
type RootComponentAllocationRequest = record {
  operation_id : blob;
  component_spec : text;
};
//
// RootComponentAllocationResponse
//
// Durable identity reservation returned identically for exact operation retry.
//
type RootComponentAllocationResponse = record {
  component : text;
  creation : opt RootComponentCreationEvidence;
  provisioning_origin : ComponentProvisioningOrigin;
  role : text;
  operation_id : blob;
  component_spec : text;
  spec_hash : blob;
  phase : RootComponentAllocationPhase;
  installation : opt RootComponentInstallEvidence;
  allocation_sequence : nat64;
  release_set : FleetSubnetRootReleaseSet;
};
//
// RootComponentChildAllocationRequest
//
// Parent command naming one idempotent direct-child reservation intent.
//
type RootComponentChildAllocationRequest = record {
  child_role : text;
  component : text;
  application_init_args : opt blob;
  operation_id : blob;
  expected_registry : ComponentRegistryHead;
};
//
// RootComponentChildAllocationResponse
//
// Durable direct-child lifecycle progress returned identically for exact parent retry.
//
type RootComponentChildAllocationResponse = record {
  maximum_descendants : nat32;
  child_kind : ComponentChildKind;
  child_role : text;
  component : text;
  maximum_registry_bytes : nat64;
  parent_canister_id : principal;
  creation : opt RootComponentCreationEvidence;
  operation_id : blob;
  maximum_instances_per_parent : nat32;
  reserved_against_registry : ComponentRegistryHead;
  phase : RootComponentAllocationPhase;
  installation : opt RootComponentChildInstallEvidence;
  release_set : FleetSubnetRootReleaseSet;
  parent_role : text;
};
//
// RootComponentChildInstallEvidence
//
// Exact child module and immutable retained binding frozen before installation.
//
type RootComponentChildInstallEvidence = record {
  chunk_hashes : vec blob;
  binding : ComponentChildBinding;
  raw_module_hash : blob;
};
// Root direct-child allocation detail projected through the operation lane.
type RootComponentChildOperationStatus = record {
  allocation : RootComponentChildAllocationResponse;
};
//
// RootComponentCreationEvidence
//
// Exact Store artifact and root-owned creation settings frozen before the paid effect.
//
type RootComponentCreationEvidence = record {
  controller : principal;
  initial_cycles : nat;
  wasm_store : principal;
  payload_size_bytes : nat64;
  canister : opt principal;
  payload_hash : blob;
};
//
// RootComponentDeletedReceipt
//
// Terminal authority retained after the top-level workload Canister is recycled.
//
type RootComponentDeletedReceipt = record {
  deletion : RootComponentDeletionIntent;
  deleted_at_ns : nat64;
};
//
// RootComponentDeletionIntent
//
// Complete final-inventory and quiescence authority frozen before top-level deletion.
//
type RootComponentDeletionIntent = record {
  final_inventory : RootComponentFinalInventory;
  prepared_at_ns : nat64;
  quiescence : RootComponentQuiescentReceipt;
};
//
// RootComponentDeletionPhase
//
// Monotonic top-level deletion progress through terminal local-membership removal.
//
type RootComponentDeletionPhase = variant {
  MembershipRemoved : RootComponentMembershipRemovedReceipt;
  DeleteIntent : RootComponentDeletionIntent;
  Deleted : RootComponentDeletedReceipt;
};
//
// RootComponentDeletionResponse
//
// Current durable deletion progress for one finalized top-level Component.
//
type RootComponentDeletionResponse = record {
  component : text;
  operation_id : blob;
  phase : RootComponentDeletionPhase;
};
//
// RootComponentDirectorySynchronizationRequest
//
// Coordinator-authenticated command advancing one affected-root scale-out Directory step.
//
type RootComponentDirectorySynchronizationRequest = record {
  plan_hash : blob;
  expected_synchronized_component_count : nat32;
  operation_id : blob;
  published_fleet_registry : FleetRegistryVersion;
  source_fleet_registry : FleetRegistryVersion;
};
//
// RootComponentDirectorySynchronizationResponse
//
// Compact exact progress for one root's affected existing service members.
//
type RootComponentDirectorySynchronizationResponse = record {
  plan_hash : blob;
  affected_component_count : nat32;
  synchronized_component_count : nat32;
  operation_id : blob;
  fleet_directory_content_hash : blob;
  complete : bool;
  published_fleet_registry : FleetRegistryVersion;
  receipt_content_hash : blob;
  fleet_subnet_root : principal;
  source_fleet_registry : FleetRegistryVersion;
  synchronized_at_ns : opt nat64;
};
//
// RootComponentDrainingRequest
//
// Controller command fencing one exact active Component against new mutation.
//
type RootComponentDrainingRequest = record {
  component : text;
  operation_id : blob;
  expected_registry : ComponentRegistryHead;
};
//
// RootComponentDrainingResponse
//
// Exact Registry and Directory authority produced by the durable draining fence.
//
type RootComponentDrainingResponse = record {
  component : text;
  descendant_count : nat32;
  started_at_ns : nat64;
  directory_authority_hash : blob;
  operation_id : blob;
  registry : ComponentRegistryHead;
  descendant_content_hash : blob;
  previous_registry : ComponentRegistryHead;
};
//
// RootComponentFinalInventory
//
// Exact empty Component Registry and current Fleet Directory authority frozen before deletion.
//
type RootComponentFinalInventory = record {
  directory_synchronized_at_ns : nat64;
  registry_encoded_bytes : nat64;
  directory_authority_hash : blob;
  covered_fleet_registry_revision : nat64;
  covered_fleet_registry_content_hash : blob;
  finalized_at_ns : nat64;
  registry : ComponentRegistryHead;
  inventory_hash : blob;
  descendant_content_hash : blob;
};
//
// RootComponentInitialInventoryStatus
//
// Durable initial Component inventory sealed for one Fleet Subnet Root activation.
//
type RootComponentInitialInventoryStatus = record {
  sealed_at_ns : nat64;
  fleet_activation_operation_id : blob;
  directories_converged : bool;
  inventory_hash : blob;
  component_count : nat32;
  root_runtime_activated : bool;
};
//
// RootComponentInstallEvidence
//
// Exact raw artifact, chunk source and immutable target binding frozen before installation.
//
type RootComponentInstallEvidence = record {
  chunk_hashes : vec blob;
  binding : ComponentBinding;
  raw_module_hash : blob;
};
//
// RootComponentMembershipRemovedReceipt
//
// Terminal local-membership removal and settled root/Spec accounting authority.
//
type RootComponentMembershipRemovedReceipt = record {
  root_known_created_component_canisters : nat32;
  deleted : RootComponentDeletedReceipt;
  allocation_operation_id : blob;
  root_committed_component_instances : nat32;
  removed_at_ns : nat64;
  root_registry_encoded_bytes : nat64;
  removal_hash : blob;
  remaining_spec_committed_instances : nat32;
};
// Root Component allocation detail projected through the operation lane.
type RootComponentOperationStatus = record {
  complete : bool;
  allocation : RootComponentAllocationResponse;
};
// Coordinator-authenticated command asking one root to retain its exact plan batch.
type RootComponentProvisioningAcceptanceRequest = record {
  fleet_registry : FleetRegistryVersion;
  plan_hash : blob;
  operation_id : blob;
  batch : FleetSubnetRootProvisioningBatch;
  configuration_digest : blob;
};
// Durable aggregate progress of one root provisioning batch.
type RootComponentProvisioningPhase = variant {
  RuntimesActive;
  Provisioned;
  Accepted;
  Published;
};
// Complete group-partitioned result of one root provisioning operation.
type RootComponentProvisioningResult = record {
  placements : vec RootProvisionedGroupPlacement;
};
// Durable progress or complete terminal result for one exact root provisioning operation.
type RootComponentProvisioningStatusResponse = record {
  fleet_registry : FleetRegistryVersion;
  result : opt RootComponentProvisioningResult;
  activation_started_at_ns : opt nat64;
  plan_hash : blob;
  published_component_count : nat32;
  provisioned_at_ns : opt nat64;
  activated_component_count : nat32;
  operation_id : blob;
  runtimes_activated_at_ns : opt nat64;
  published_at_ns : opt nat64;
  root_runtime_active : bool;
  claimed_component_count : nat32;
  installed_component_count : nat32;
  receipt_content_hash : blob;
  accepted_at_ns : nat64;
  fleet_subnet_root : principal;
  reserved_component_count : nat32;
  activation : opt RootComponentActivationEvidence;
  estate_funding_required : opt RootEstateFundingRequired;
  phase : RootComponentProvisioningPhase;
  registry_committed_component_count : nat32;
  placement_count : nat32;
  configuration_digest : blob;
  component_count : nat32;
  publication : opt RootComponentPublicationEvidence;
};
// Complete root-local evidence for one published provisioning batch.
type RootComponentPublicationEvidence = record {
  fleet_registry : FleetRegistryVersion;
  fleet_directory_content_hash : blob;
  component_group_directories : vec ComponentGroupDirectoryPublicationEvidence;
  component_directories : vec ComponentDirectoryPublicationEvidence;
};
//
// RootComponentQuiescenceStopIntent
//
// Exact runtime, Directory, module and controller authority frozen before stopping.
//
type RootComponentQuiescenceStopIntent = record {
  controller : principal;
  descendant_count : nat32;
  expected_module_hash : blob;
  prepared_at_ns : nat64;
  canister_id : principal;
  runtime_operation_id : blob;
  covered_fleet_registry_revision : nat64;
  activation : ComponentRuntimeActivationEvidence;
  covered_fleet_registry_content_hash : blob;
  registry : ComponentRegistryHead;
  covered_authority_hash : blob;
  descendant_content_hash : blob;
};
//
// RootComponentQuiescentReceipt
//
// Durable evidence that the exact prepared Component was independently observed stopped.
//
type RootComponentQuiescentReceipt = record {
  stop : RootComponentQuiescenceStopIntent;
  quiesced_at_ns : nat64;
  observed_module_hash : blob;
};
//
// RootComponentRegistryPreparationRequest
//
// Exact authority required before an empty root-local Component Registry may be prepared.
//
type RootComponentRegistryPreparationRequest = record {
  store_bootstrap : RootStoreBootstrapRequest;
  expected_fleet_registry : FleetRegistryVersion;
};
//
// RootComponentRegistryStatusResponse
//
// Compact durable Component Registry authority and current allocation counters.
//
type RootComponentRegistryStatusResponse = record {
  next_allocation_sequence : nat64;
  component_topology_digest : blob;
  initial_inventory : opt RootComponentInitialInventoryStatus;
  known_created_component_canisters : nat32;
  committed_component_instances : nat32;
  prepared_against_registry : FleetRegistryVersion;
  managed_descendants : nat32;
  reserved_component_instances : nat32;
  fleet_subnet_root : principal;
  encoded_bytes : nat64;
  release_set : FleetSubnetRootReleaseSet;
};
// Root Component removal detail projected through the operation lane.
type RootComponentRemovalOperationStatus = record {
  deletion : opt RootComponentDeletionResponse;
  draining : RootComponentDrainingResponse;
};
//
// RootComponentSubtreeRemovalCompletedReceipt
//
// Terminal Registry and Directory authority after the fenced target is finalized.
//
type RootComponentSubtreeRemovalCompletedReceipt = record {
  directory_authority_hash : blob;
  registry : ComponentRegistryHead;
};
//
// RootComponentSubtreeRemovalDeleteIntent
//
// Exact stopped receipt frozen before the destructive management call.
//
type RootComponentSubtreeRemovalDeleteIntent = record {
  stopped : RootComponentSubtreeRemovalStoppedReceipt;
};
//
// RootComponentSubtreeRemovalDeletedReceipt
//
// Frozen workload-deletion authority committed after the Canister is recycled.
//
type RootComponentSubtreeRemovalDeletedReceipt = record {
  deletion : RootComponentSubtreeRemovalDeleteIntent;
};
//
// RootComponentSubtreeRemovalDirectoryConvergenceEvidence
//
// Compact durable proof that one surviving member covered the required Directory.
//
type RootComponentSubtreeRemovalDirectoryConvergenceEvidence = record {
  canister_id : principal;
  operation_id : blob;
  activation : ComponentRuntimeActivationEvidence;
};
//
// RootComponentSubtreeRemovalDirectorySynchronizedReceipt
//
// Membership removal plus independently verified surviving-member convergence.
//
// The owner is absent only when its top-level Component is durably quiescent.
//
type RootComponentSubtreeRemovalDirectorySynchronizedReceipt = record {
  covered_component_registry : ComponentRegistryHead;
  owning_component : opt RootComponentSubtreeRemovalDirectoryConvergenceEvidence;
  membership_removed : RootComponentSubtreeRemovalMembershipRemovedReceipt;
  covered_fleet_registry_revision : nat64;
  covered_fleet_registry_content_hash : blob;
  covered_authority_hash : blob;
  parent : opt RootComponentSubtreeRemovalDirectoryConvergenceEvidence;
};
//
// RootComponentSubtreeRemovalMembershipRemovedReceipt
//
// Exact Registry transition retained after the independently deleted leaf is unregistered.
//
type RootComponentSubtreeRemovalMembershipRemovedReceipt = record {
  root_known_created_component_canisters : nat32;
  directory_synchronized_at_ns : nat64;
  parent_role_instances : nat32;
  deleted : RootComponentSubtreeRemovalDeletedReceipt;
  registry_encoded_bytes : nat64;
  directory_authority_hash : blob;
  previous_committed_descendants : nat32;
  reserved_descendants : nat32;
  previous_descendant_content_hash : blob;
  committed_descendants : nat32;
  registry : ComponentRegistryHead;
  descendant_content_hash : blob;
  removed_from_registry : ComponentRegistryHead;
  root_managed_descendants : nat32;
};
//
// RootComponentSubtreeRemovalNode
//
// Exact registered child selected as a traversal cursor or removable leaf.
//
type RootComponentSubtreeRemovalNode = record {
  status : ComponentLifecycleStatus;
  parent_canister_id : principal;
  kind : ComponentChildKind;
  role : text;
  canister_id : principal;
  installed_artifact_hash : blob;
};
//
// RootComponentSubtreeRemovalPhase
//
// Durable root-local progress of one child-subtree removal operation.
//
type RootComponentSubtreeRemovalPhase = variant {
  DirectorySynchronized : RootComponentSubtreeRemovalDirectorySynchronizedReceipt;
  MembershipRemoved : RootComponentSubtreeRemovalMembershipRemovedReceipt;
  Stopped : RootComponentSubtreeRemovalStoppedReceipt;
  Traversing : RootComponentSubtreeRemovalNode;
  Fenced;
  StopIntent : RootComponentSubtreeRemovalStopIntent;
  DeleteIntent : RootComponentSubtreeRemovalDeleteIntent;
  LeafSelected : RootComponentSubtreeRemovalNode;
  Deleted : RootComponentSubtreeRemovalDeletedReceipt;
  Completed : RootComponentSubtreeRemovalCompletedReceipt;
};
//
// RootComponentSubtreeRemovalRequest
//
// Controller command durably fencing one registered child subtree.
//
type RootComponentSubtreeRemovalRequest = record {
  component : text;
  operation_id : blob;
  target_canister_id : principal;
  expected_registry : ComponentRegistryHead;
};
//
// RootComponentSubtreeRemovalResponse
//
// Current durable snapshot of one monotonic subtree-removal operation.
//
type RootComponentSubtreeRemovalResponse = record {
  component : text;
  completed_leaves : nat32;
  operation_id : blob;
  target_canister_id : principal;
  reserved_against_registry : ComponentRegistryHead;
  phase : RootComponentSubtreeRemovalPhase;
  target_status : ComponentLifecycleStatus;
  traversal_steps : nat32;
  target_parent_canister_id : principal;
  maximum_completed_leaves : nat32;
  target_role : text;
};
//
// RootComponentSubtreeRemovalStopIntent
//
// Exact registered leaf and sole root controller frozen before a stop call.
//
type RootComponentSubtreeRemovalStopIntent = record {
  controller : principal;
  leaf : RootComponentSubtreeRemovalNode;
};
//
// RootComponentSubtreeRemovalStoppedReceipt
//
// Frozen stop authority plus the independently observed installed module.
//
type RootComponentSubtreeRemovalStoppedReceipt = record {
  stop : RootComponentSubtreeRemovalStopIntent;
  observed_module_hash : blob;
};
type RootDelegationProofBatchProof = record {
  cert_hash : blob;
  issuer_pid : principal;
  proof : DelegationProof;
};
// Exact durable funding pause for one Root-owned autonomous pool creation.
type RootEstateFundingRequired = record {
