// Controller-only Root operating-funding and emergency-refill projection.
type RootFundingStatusResponse = record {
  funding_eligible : bool;
  automatic_grants : nat32;
  current_cycles : nat;
  icp_window_reserved_e8s : nat64;
  last_result : opt FleetRootFundingResponse;
  automatic_icp_refills : nat32;
  historical_automatic_grants : nat64;
  funding_profile : FleetFundingProfile;
  policy_generation : nat64;
  root_policy : FleetSubnetRootFundingPolicy;
  automatic_cycles : nat;
  rotation_current : opt FleetFundingPolicyRotationRootReceipt;
  policy_hash : blob;
  cycles_funding_enabled : bool;
  fleet_subnet_root : principal;
  icp_window_start_secs : opt nat64;
