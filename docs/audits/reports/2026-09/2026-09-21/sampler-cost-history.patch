@@ -0,0 +1,40 @@
+//! Temporary controlled sampler attribution fixture.
+use canic::{
+    Error,
+    api::public_status::{ApplicationMetricsSampler, PublicStatusApi},
+    dto::public_status::{PublicMetric, PublicMetricKind},
+};
+use std::cell::Cell;
+thread_local! { static ROWS: Cell<u16> = const { Cell::new(0) }; }
+#[derive(candid::CandidType)]
+pub(super) struct SamplingCost {
+    total: u64,
+    phases: Vec<(String, u64)>,
+}
+pub(super) fn run(rows: u16) -> Result<SamplingCost, Error> {
+    assert!(rows <= 256);
+    ROWS.set(rows);
+    PublicStatusApi::set_application_sampler(Some(ApplicationMetricsSampler::new(provider)));
+    canic::__internal::core::api::public_status::audit_start();
+    let start = ic_cdk::api::performance_counter(0);
+    let result = PublicStatusApi::sample_metrics();
+    let total = ic_cdk::api::performance_counter(0) - start;
+    let phases = canic::__internal::core::api::public_status::audit_finish();
+    result?;
+    Ok(SamplingCost { total, phases })
+}
+fn provider() -> Result<Vec<PublicMetric>, Error> {
+    let now = ic_cdk::api::time();
+    Ok((0..ROWS.get())
+        .map(|index| PublicMetric {
+            name: format!(
+                "icydb.entity.synthetic_qualified_entity_path_{index:04}.instructions_total"
+            ),
+            unit: "instructions".into(),
+            value: u128::from(index),
+            canister_id: None,
+            observed_at_ns: now,
+            kind: PublicMetricKind::Gauge,
+        })
+        .collect())
+}
