+// Temporary investigation counters; removed after retained evidence is collected.
+thread_local! {
+    static AUDIT_PHASES: RefCell<Option<Vec<(String, u64)>>> = const { RefCell::new(None) };
+}
+pub fn audit_start() {
+    AUDIT_PHASES.with_borrow_mut(|phases| *phases = Some(Vec::new()));
+}
+pub fn audit_finish() -> Vec<(String, u64)> {
+    AUDIT_PHASES.with_borrow_mut(|phases| phases.take().unwrap_or_default())
+}
+pub fn audit_phase(label: impl Into<String>, start: u64) {
+    let elapsed = crate::perf::perf_counter().saturating_sub(start);
+    AUDIT_PHASES.with_borrow_mut(|phases| {
+        if let Some(phases) = phases {
+            phases.push((label.into(), elapsed));
+        }
+    });
+}
+
+pub fn audit_value(label: impl Into<String>, value: u64) {
+    AUDIT_PHASES.with_borrow_mut(|phases| {
+        if let Some(phases) = phases {
+            phases.push((label.into(), value));
+        }
+    });
+}
